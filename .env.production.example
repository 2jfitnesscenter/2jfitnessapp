# Production values for app.2jfitnesscenter.com on the Raiola VPS.
#
# On the server: copy this to ".env" (NOT the local-dev .env.example), then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

RP_ID=app.2jfitnesscenter.com
ORIGIN=https://app.2jfitnesscenter.com
WEB_PORT=8080
RP_NAME=2J Fitness Center

# ── Admin dashboard ─────────────────────────────────────────────────────────
# Passkeys are bound to the exact hostname (see docs/SELF_HOSTING.md section 2) — the passkey
# from your local-testing instance will NOT work here. Leave ADMIN_UIDS commented out, boot the
# stack, register a brand-new profile at https://app.2jfitnesscenter.com, find your new user id
# in ./data/db.json ("users"[].id), then uncomment this with that id and restart:
#
#   ADMIN_UIDS=youruserid
#
# Optional — require an invite code for new signups (generate codes from the admin dashboard
# once you're an admin):
#
#   INVITE_ONLY=1

# ── Session length (optional) ──────────────────────────────────────────────
# Default 90 days is fine for a gym instance on the open internet. Lower it if you'd rather
# members re-confirm with their passkey more often.
#
#   SESSION_DAYS=90

# ── AI Coach ────────────────────────────────────────────────────────────────
# Nothing to set here — like ADMIN_UIDS, the Gemini connection from your local instance does not
# carry over (it's encrypted against this server's own ./data/secret, generated fresh on first
# boot). Reconnect it the same way you did locally: Settings → Admin dashboard → AI Coach →
# provider "Google Gemini" → "Usar una clave de API" → paste the same key.

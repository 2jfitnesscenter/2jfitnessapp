# Copy this file to ".env" and adjust for your setup, then: docker compose up -d
#
# ── Local testing (default) ────────────────────────────────────────────────
# Works out of the box on the machine running Docker. Open http://localhost:8080
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=2J Fitness Center
# Optional gym-local date for today's Bunker PRs; default is Atlantic/Canary.
# GYM_TIME_ZONE=Atlantic/Canary

# ── Real deployment behind your own HTTPS domain ───────────────────────────
# Passkeys are bound to the exact hostname, and browsers only allow them over
# HTTPS (localhost is the one exception). Put 2J Fitness Center behind a reverse proxy /
# tunnel that terminates TLS for your domain, then set:
#
#   RP_ID=gym.example.com
#   ORIGIN=https://gym.example.com
#   WEB_PORT=8080
#   RP_NAME=2J Fitness Center
#
# (Point your proxy at the web container's WEB_PORT. See docs/SELF_HOSTING.md.)

# ── Admin dashboard & invite-only signup (optional) ────────────────────────
# Both off by default — a fresh instance has open signup and no admin.
#
# Make yourself an admin: register your own passkey profile first, find your
# user id in ./data/db.json ("users"[].id), then list it here (comma-separated
# for several admins). Admins get an "Admin dashboard" link in Settings to see
# users, disable accounts, generate invite codes and view workout history.
#
#   ADMIN_UIDS=youruserid,anotheradmin
#
# Require an invite code to create new profiles (existing accounts keep working;
# generate the codes from the admin dashboard):
#
#   INVITE_ONLY=1

# ── Session length (optional) ──────────────────────────────────────────────
# How long a sign-in lasts, in days. Default 90 — long enough that people who
# train regularly never see a login screen, short enough that a stolen cookie
# doesn't stay good forever. Lower it for an instance on the open internet,
# raise it for a private one. Only affects new sign-ins; cookies already handed
# out keep the lifetime they were issued with. Users can end every session on
# every device themselves with "Sign out everywhere" in Settings.
#
#   SESSION_DAYS=90

# ── Notifications (optional) ───────────────────────────────────────────────
# Push works out of the box — nothing to set. VAPID keys are generated on first
# run and saved to ./data/vapid.json. Each user's browser reports its own
# timezone automatically, so the workout-day reminder fires at their local
# time regardless of where the server runs or where they're travelling.

# ── AI Coach (optional) ────────────────────────────────────────────────────
# Nothing to set. Claude's Agent SDK and the OpenAI Codex CLI are built into the api image;
# neither path needs an API key. Enable one from Settings → Admin → AI Coach.
#
# Claude: on a trusted computer where Claude Code is installed, run `claude setup-token`, then
# paste its value into "Add CLI token". Codex: choose "Sign in with ChatGPT" and complete the
# device-code flow in a trusted browser. Codex keeps its refreshable CLI cache in ./data/codex;
# treat that directory like a password-bearing backup. The app never handles a browser OAuth
# callback. It stays off until an admin turns it on, and each profile has to consent separately.
#
# The one knob here is a kill switch: set this and the Coach reports as disabled
# everywhere regardless of what is stored, which is useful for a fleet of
# instances you do not want the feature on for.
#
#   COACH_DISABLED=1

# ── Platform verified-account proof (shadow mode; explicitly opt-in) ────────
# Each route stays disabled unless its individual flag is explicitly set to true.
# Keep all false in every deployed environment until a separate go-live review.
PLATFORM_PROOF_ISSUANCE_ENABLED=false
PLATFORM_PROOF_EXCHANGE_ENABLED=false
PLATFORM_PROOF_RECONCILIATION_ENABLED=false
# Optional JSON object: {"key-id":"base64url-encoded-random-secret", ...}
# Each decoded key must contain at least 32 random bytes. Configure outside source control.
PLATFORM_SERVICE_AUTH_KEYS=

# Platform SSO + capability consumption (names only; never commit populated values; secrets live in the runtime secret store).
# Everything stays OFF unless PLATFORM_SSO_ENABLED=true AND a Platform API client is configured. Enforcement is then opted in PER USER
# by an administrator (legacy -> shadow -> enforced); there is no global switch.
PLATFORM_SSO_ENABLED=false
PLATFORM_API_BASE_URL=
PLATFORM_API_KEY_ID=
PLATFORM_API_KEY_SECRET=
# Origin of the Home member app (https, or http on loopback; no path). The browser-bound SSO flow starts here, at /api/platform/v1/sso/start, and goes
# to Home carrying only the SHA-256 of a secret kept in an HttpOnly cookie of THIS origin. Without it the flow cannot begin and SSO stays unusable.
PLATFORM_HOME_URL=
# Bilateral link lifecycle and provisioning from Platform (each OFF by default; both need PLATFORM_SERVICE_AUTH_KEYS).
PLATFORM_LINK_LIFECYCLE_ENABLED=false
PLATFORM_PROVISIONING_ENABLED=false
# Signed Platform -> Training suspension signals (2J-CAPABILITY-SIGNAL-V1; OFF by default; needs PLATFORM_SERVICE_AUTH_KEYS). Restrict-only: they never grant access.
PLATFORM_SIGNALS_ENABLED=false

# Reverse proxies allowed to tell the API the client address (comma-separated IPv4 CIDRs /8../32 or exact IPv6). Recommended before exposing the service:
# the compose subnet of nginx plus the address Caddy connects from. Unset = legacy rule (any private peer is believed; the edge must overwrite X-Forwarded-For).
TRUSTED_PROXIES=

# Capabilities contract Búnker asks Platform for. Default 2J-CAPABILITIES-V2 (unchanged behaviour). 2J-CAPABILITIES-V2.1 = free Entrena con 2J + Premium (D40/D41), registered people need no Búnker link (A23). Needs Platform with the /v2.1/ endpoint.
PLATFORM_CAPABILITIES_CONTRACT=

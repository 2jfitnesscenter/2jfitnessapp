grep -Fq 'libraryOverlay: libraryAdmin.publicOverlay(), guidedRev: guidedStore.contentRev()' "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "'library-admin.json'" "$RELEASE_CHECK_DIR/api/lib/library-admin.js"
grep -Fq "lib_overlay_v1" "$RELEASE_CHECK_DIR/frontend/src/lib/library/overlay-sync.js"
grep -Fq 'notifyRev' "$RELEASE_CHECK_DIR/frontend/src/lib/guided-api.js"
printf 'STUDIO_RELEASE=OK admin_routes=requireAdmin library_overlay=config+offline_cache guidedRev=config lazy_studio_chunks=3\n'
printf 'GYM_PROFILES_V11_RELEASE=OK equipment=19 api_frontend_model=identical config_persistence=global default_fallback=present read=/api/config write=admin_only offline_cache=separate library+swap+constructor+workout+train2j+ai+bunker_context=present\n'
@@SOURCE_PROBES@@
printf 'RELEASE_SCOPE=OK changed=@@DELTA_COUNT@@ exact_delta_from_@@EXPECTED_CURRENT_SHORT@@ outside_delta_identical=yes\n'
# Seguimiento V4 (routine review loop): the shared engine is one byte-identical file on both sides, the staff write is admin-only and only touches S.routineReviews,
# the review never edits a routine, and Sync V2 / auth / the follow-up endpoints keep their guards.
cmp -s "$RELEASE_CHECK_DIR/api/lib/routine-review.js" "$RELEASE_CHECK_DIR/frontend/src/lib/routine-review.js" || { printf 'ROUTINE_REVIEW_COPY_DIFFERS\n'; false; }
grep -Fq 'export const REVIEW_WEEK = 5' "$RELEASE_CHECK_DIR/api/lib/routine-review.js"
grep -Fq 'export const EARLY_WEEK = 4' "$RELEASE_CHECK_DIR/api/lib/routine-review.js"
grep -Fq 'export const MIN_SESSIONS = 3' "$RELEASE_CHECK_DIR/api/lib/routine-review.js"
grep -Fq "import { pendingReviews } from './routine-review.js';" "$RELEASE_CHECK_DIR/api/lib/followup.js"
grep -Fq "code: 'routine_review'" "$RELEASE_CHECK_DIR/api/lib/followup.js"
grep -Fq "import { markReviewed, setCycleDates, routineReviews } from './lib/routine-review.js';" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "'POST /api/admin/user/routine-reviewed': async (req, res) => {" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "directReceipt(S, body, 'admin-routine-reviewed')" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "if (!requireAdmin(req, res)) return;" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "'GET /api/admin/user/followup': async (req, res) => {" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "if (!user?.admin) return null" "$RELEASE_CHECK_DIR/frontend/src/views/AdminAttention.jsx"
grep -Fq "stateAction('/api/admin/user/routine-reviewed'" "$RELEASE_CHECK_DIR/frontend/src/views/AdminAttention.jsx"
cmp -s "$RELEASE_CHECK_DIR/api/lib/sync.js" "$BASELINE_CHECK_DIR/api/lib/sync.js" || { printf 'SYNC_JS_CHANGED\n'; false; }
cmp -s "$RELEASE_CHECK_DIR/frontend/src/lib/sync-client.js" "$BASELINE_CHECK_DIR/frontend/src/lib/sync-client.js" || { printf 'SYNC_CLIENT_CHANGED\n'; false; }
cmp -s "$RELEASE_CHECK_DIR/api/lib/webauthn-origins.js" "$BASELINE_CHECK_DIR/api/lib/webauthn-origins.js" || { printf 'WEBAUTHN_ORIGINS_CHANGED\n'; false; }
test -s "$RELEASE_CHECK_DIR/api/test/routine-review.test.js"
grep -Fq "'POST /api/admin/user/routine-cycle': async (req, res) => {" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "directReceipt(S, body, 'admin-routine-cycle')" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "export function setCycleDates(" "$RELEASE_CHECK_DIR/api/lib/routine-review.js"
grep -Fq "startOverride" "$RELEASE_CHECK_DIR/api/lib/routine-review.js"
grep -Fq "dueOverride" "$RELEASE_CHECK_DIR/api/lib/routine-review.js"
! grep -Eq "markReviewed|setCycleDates|routineReviews" "$RELEASE_CHECK_DIR/frontend/src/views/Seguimiento.jsx" "$RELEASE_CHECK_DIR/frontend/src/views/Home.jsx" "$RELEASE_CHECK_DIR/frontend/src/components/RoutineReviewCard.jsx"
grep -Fq "'routine-cycle'" "$RELEASE_CHECK_DIR/frontend/src/views/AdminFollowUp.jsx"
grep -Fq 'type="date"' "$RELEASE_CHECK_DIR/frontend/src/views/AdminFollowUp.jsx"
grep -A1 -F "'POST /api/admin/user/routine-reviewed'" "$RELEASE_CHECK_DIR/api/server.js" | grep -Fq 'requireTrainer(req, res)'
grep -A1 -F "'POST /api/admin/user/routine-cycle'" "$RELEASE_CHECK_DIR/api/server.js" | grep -Fq 'requireTrainer(req, res)'
grep -A1 -F "'GET /api/trainer/routine-cycles'" "$RELEASE_CHECK_DIR/api/server.js" | grep -Fq 'requireTrainer(req, res)'
grep -A1 -F "'POST /api/admin/user/role'" "$RELEASE_CHECK_DIR/api/server.js" | grep -Fq 'requireAdmin(req, res)'
grep -Fq "code: 'last_admin'" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "code: 'admin_by_config'" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "if (role === 'admin') { u.admin = true; delete u.trainer; }" "$RELEASE_CHECK_DIR/api/server.js"
grep -Fq "'/api/admin/user/role'" "$RELEASE_CHECK_DIR/frontend/src/views/Admin.jsx"
grep -Fq "t('Change role?')" "$RELEASE_CHECK_DIR/frontend/src/views/Admin.jsx"
grep -Fq "RoutineCycles" "$RELEASE_CHECK_DIR/frontend/src/views/trainer/TrainerClientPlan.jsx"
test -s "$RELEASE_CHECK_DIR/api/test/roles.test.js"
cmp -s "$RELEASE_CHECK_DIR/api/lib/fatigue.js" "$RELEASE_CHECK_DIR/frontend/src/lib/fatigue.js" || { printf 'FATIGUE_COPY_DIFFERS\n'; false; }
cmp -s "$RELEASE_CHECK_DIR/api/lib/routine-review.js" "$RELEASE_CHECK_DIR/frontend/src/lib/routine-review.js" || { printf 'ROUTINE_REVIEW_COPY_DIFFERS\n'; false; }
grep -Fq 'export function deloadProposal(' "$RELEASE_CHECK_DIR/api/lib/fatigue.js"
grep -Fq 'export function applyDeload(' "$RELEASE_CHECK_DIR/api/lib/fatigue.js"
grep -Fq 'export const DELOAD_VOLUME_CUT = 0.35' "$RELEASE_CHECK_DIR/api/lib/fatigue.js"
grep -Fq 'export const DELOAD_DAYS = 7' "$RELEASE_CHECK_DIR/api/lib/fatigue.js"
grep -Fq "import { fatigueState, deloadProposal, activeDeload } from './fatigue.js';" "$RELEASE_CHECK_DIR/api/lib/followup.js"
grep -Fq "code: 'fatigue_high'" "$RELEASE_CHECK_DIR/api/lib/followup.js"
grep -Fq 'function regulate(S, cfg, routine, p)' "$RELEASE_CHECK_DIR/frontend/src/lib/progression.js"
grep -Fq 'export function withDeload(' "$RELEASE_CHECK_DIR/frontend/src/lib/progression.js"
grep -Fq "!entry.target?.deload" "$RELEASE_CHECK_DIR/frontend/src/lib/progression.js"
grep -Fq "S.autoreg === false" "$RELEASE_CHECK_DIR/frontend/src/lib/progression.js"
! grep -Eq "applyDeload|cancelDeload|S.deload" "$RELEASE_CHECK_DIR/frontend/src/views/AdminAttention.jsx" "$RELEASE_CHECK_DIR/frontend/src/views/AdminFollowUp.jsx"
grep -Fq "applyDeload" "$RELEASE_CHECK_DIR/frontend/src/components/ReadinessSection.jsx"
grep -Fq "uxOn(S, 'recovery')" "$RELEASE_CHECK_DIR/frontend/src/components/ReadinessSection.jsx"
# api/server.js has exact role/routine-review deltas in the pinned file list; route guards + API tests below validate them.
cmp -s "$RELEASE_CHECK_DIR/api/lib/sync.js" "$BASELINE_CHECK_DIR/api/lib/sync.js" || { printf 'SYNC_JS_CHANGED\n'; false; }
cmp -s "$RELEASE_CHECK_DIR/api/lib/webauthn-origins.js" "$BASELINE_CHECK_DIR/api/lib/webauthn-origins.js" || { printf 'WEBAUTHN_ORIGINS_CHANGED\n'; false; }
cmp -s "$RELEASE_CHECK_DIR/frontend/src/lib/sync-client.js" "$BASELINE_CHECK_DIR/frontend/src/lib/sync-client.js" || { printf 'SYNC_CLIENT_CHANGED\n'; false; }
test -s "$RELEASE_CHECK_DIR/api/test/fatigue.test.js"
printf 'READINESS_FATIGUE=OK engine_copy_identical autoreg_layer_over_progression deload_proposal_only member_applies staff_cannot_apply server_sync_auth_unchanged\n'
printf 'ROUTINE_REVIEW=OK engine_copy_identical week5+week4_plateau manual_dates trainer_cycle_access role_management_admin_only last_admin_guard member_cannot_close sync_auth_unchanged\n'
# Sync V2 runtime is an exact baseline copy. Approved history selectors changed only within the exact delta above.
cmp -s "$RELEASE_CHECK_DIR/frontend/src/lib/sync-client.js" "$BASELINE_CHECK_DIR/frontend/src/lib/sync-client.js" || { printf 'SYNC_OR_HISTORY_CHANGED=%s\n' frontend/src/lib/sync-client.js; false; }
# Sprint 3 (owner-approved, this release only): api/lib/sync.js may differ from the baseline ONLY if it is byte-identical to the approved
# receipt-pruning version, pinned by SHA-256. Any other content aborts.
# Owner-approved: exactly two digests for the same content - LF (the git blob) and CRLF (what `git archive` ships on the release machine,
# core.autocrlf=true, like every other file in the release). Any third digest aborts.
APPROVED_SYNC_JS_SHA256_LF=@@SYNC_JS_SHA256_LF@@
APPROVED_SYNC_JS_SHA256_CRLF=@@SYNC_JS_SHA256_CRLF@@
ACTUAL_SYNC_JS_SHA256=$(sha256sum "$RELEASE_CHECK_DIR/api/lib/sync.js" | cut -d' ' -f1)
[[ "$ACTUAL_SYNC_JS_SHA256" == "$APPROVED_SYNC_JS_SHA256_LF" || "$ACTUAL_SYNC_JS_SHA256" == "$APPROVED_SYNC_JS_SHA256_CRLF" ]] || { printf 'SYNC_JS_HASH_MISMATCH=%s\n' "$ACTUAL_SYNC_JS_SHA256"; false; }
printf 'SYNC_JS_SHA256=%s\n' "$ACTUAL_SYNC_JS_SHA256"
printf 'SYNC_GUARD=OK sync-client=baseline sync.js=approved-sha256\n'
PROTOCOL_FILES=0
for src in "$RELEASE_CHECK_DIR"/frontend/src/lib/protocol/*.js; do
  name=$(basename "$src")
  [[ "$name" == *.test.js ]] && continue
  dst="$RELEASE_CHECK_DIR/api/lib/protocol/$name"
  test -s "$dst"
  tail -n +2 "$dst" | cmp -s - "$src"
  PROTOCOL_FILES=$((PROTOCOL_FILES + 1))
done
[[ "$PROTOCOL_FILES" == 9 ]]
printf 'RELEASE_PROTOCOL=OK v1.0 runtime_copy=%s files in sync\n' "$PROTOCOL_FILES"
rm -rf -- "$BASELINE_CHECK_DIR"
rm -rf -- "$DELTA_CHECK_DIR"
STEP=verify-current-production
test -d "$APP/data"
test -s "$APP/.env"
WEB_PORT=$(awk -F= '$1 == "WEB_PORT" {gsub(/[[:space:]#].*$/, "", $2); print $2; exit}' "$APP/.env")
WEB_PORT=${WEB_PORT:-8080}
[[ "$WEB_PORT" =~ ^[0-9]{2,5}$ ]] && (( WEB_PORT >= 1 && WEB_PORT <= 65535 ))
test -s "$APP/data/db.json"
test -s "$APP/data/secret"
test -s "$APP/.deployed-commit"
[[ "$(cat "$APP/.deployed-commit")" == "$ROLLBACK_COMMIT" ]]
CURRENT_CHECK_DIR=$(mktemp -d /tmp/2j-current-@@EXPECTED_CURRENT_SHORT@@.XXXXXX)
tar -xzf "$ROLLBACK" -C "$CURRENT_CHECK_DIR"
tar -tzf "$ROLLBACK" | sort > "$CURRENT_CHECK_DIR/rollback-files.txt"
tar -tzf "$RELEASE" | sort > "$CURRENT_CHECK_DIR/target-files.txt"
while IFS= read -r rel; do
  [[ -z "$rel" || -d "$CURRENT_CHECK_DIR/$rel" ]] && continue
  if [[ -L "$CURRENT_CHECK_DIR/$rel" ]]; then
    [[ -L "$APP/$rel" && "$(readlink "$APP/$rel")" == "$(readlink "$CURRENT_CHECK_DIR/$rel")" ]] || {
      printf 'CURRENT_MISMATCH=%s\n' "$rel"
      false
    }
  else
    test -f "$APP/$rel"
    cmp -s "$CURRENT_CHECK_DIR/$rel" "$APP/$rel" || {
      printf 'CURRENT_MISMATCH=%s\n' "$rel"
      false
    }
  fi
done < "$CURRENT_CHECK_DIR/rollback-files.txt"
comm -23 "$CURRENT_CHECK_DIR/target-files.txt" "$CURRENT_CHECK_DIR/rollback-files.txt" > "$CURRENT_CHECK_DIR/target-only.txt"
# A target-only FILE already in production is contamination: abort, production untouched.
while IFS= read -r rel; do
  [[ -z "$rel" || "$rel" == */ || "$rel" == data || "$rel" == data/* ]] && continue
  if [[ -e "$APP/$rel" || -L "$APP/$rel" ]]; then
    printf 'UNEXPECTED_TARGET_FILE_ALREADY_PRESENT=%s\n' "$rel"
    false
  fi
done < "$CURRENT_CHECK_DIR/target-only.txt"
# A target-only DIRECTORY can be residue from an older rollback. Inspect and report it here, but
# do not mutate production before the verified data backup. The install phase removes empty stale
# directories after the backup; a non-empty directory remains a hard precheck failure.
STALE_EMPTY_DIRS=''
while IFS= read -r rel; do
  [[ -z "$rel" || "$rel" == data/ || "$rel" == data/* ]] && continue
  [[ -d "$APP/$rel" ]] || continue
  if [[ -n "$(find "$APP/$rel" -mindepth 1 -print -quit)" ]]; then
    printf 'UNEXPECTED_TARGET_DIR_NOT_EMPTY=%s\n' "$rel"
    find "$APP/$rel" -mindepth 1 | head -20 | sed 's/^/  /'
    false
  fi
  printf 'STALE_EMPTY_DIR_PRESENT=%s\n' "$rel"
  STALE_EMPTY_DIRS="$STALE_EMPTY_DIRS$rel,"
done < <(grep '/$' "$CURRENT_CHECK_DIR/target-only.txt" | sort -r || true)
# Check all real frontend/API/script/web source files, pruning generated/build/dependency output.
# Compare repository-relative paths against the exact release archive; no unexpected source passes silently.
EXTRA_CODE=$(cd "$APP" && { find frontend api scripts web \
  \( -type d \( -name node_modules -o -name dist -o -name coverage -o -name .cache -o -name .vite -o -name build -o -name .next \) -prune \) -o \
  \( -type f -o -type l \) -print 2>/dev/null || true; } | sort | comm -23 - <(grep -v '/$' "$CURRENT_CHECK_DIR/rollback-files.txt"))
if [[ -n "$EXTRA_CODE" ]]; then printf 'CURRENT_EXTRA_CODE_FILE=%s\n' $EXTRA_CODE; false; fi
rm -rf -- "$CURRENT_CHECK_DIR"
printf 'PREDEPLOY_PRODUCTION=%s source-tree=exact-release-match extra_code_files=0 stale_empty_dirs_present=[%s]\n' "$ROLLBACK_COMMIT" "$STALE_EMPTY_DIRS"
DATA_KB=$(du -sk "$APP/data" | awk '{print $1}')
FREE_KB=$(df -Pk "$APP" | awk 'END {print $4}')
(( FREE_KB > DATA_KB * 2 + 100000 )) || { printf 'INSUFFICIENT_SPACE free_kb=%s data_kb=%s\n' "$FREE_KB" "$DATA_KB"; false; }

STEP=backup-data
# Compose uses relative file names, so every `docker compose` below (the features.json check needs it) must run inside $APP.
cd "$APP"
BACKUP=/root/backups/2jfitness-predeploy-@@TARGET_SHORT@@-$STAMP.tar.gz
# The whole data/ directory, with numeric owners and modes (db.json, secret, state-*.json,
# blocks.json, guided.json and anything else that lives there), not a list of known files.
tar --numeric-owner -czpf "$BACKUP" -C "$APP" data
test -s "$BACKUP"
gzip -t "$BACKUP"
tar -tzf "$BACKUP" data/db.json data/secret >/dev/null
STATE_COUNT=$(tar -tzf "$BACKUP" | awk '/^data\/state-.*\.json$/ {count++} END {print count+0}')
(( STATE_COUNT > 0 ))
SECRET_HASH_BEFORE=$(sha256sum "$APP/data/secret" | awk '{print $1}')
ENV_HASH_BEFORE=$(sha256sum "$APP/.env" | awk '{print $1}')
DATA_DIR_ID_BEFORE=$(stat -c '%d:%i' "$APP/data")
VAPID_BEFORE=absent
if [[ -f "$APP/data/vapid.json" ]]; then
  VAPID_HASH_BEFORE=$(sha256sum "$APP/data/vapid.json" | awk '{print $1}')
  VAPID_BEFORE=present
fi
DATA_OWNER_BEFORE=$(stat -c '%U:%G' "$APP/data")
DATA_MODE_BEFORE=$(stat -c '%a' "$APP/data")
SECRET_META_BEFORE=$(stat -c '%U:%G:%a' "$APP/data/secret")
DB_META_BEFORE=$(stat -c '%U:%G:%a' "$APP/data/db.json")
LIVE_STATE_BEFORE=$(find "$APP/data" -maxdepth 1 -name 'state-*.json' | wc -l)
[[ "$LIVE_STATE_BEFORE" == "$STATE_COUNT" ]]
declare -A MUTABLE_META_BEFORE=()
REQUIRED_MUTABLE_FILES=''
for name in db.json notifications.json friends.json chat.json social.json social-sharing.json blocks.json guided.json library-admin.json news.json features.json gym-profile.json; do
  if [[ -f "$APP/data/$name" ]]; then
    MUTABLE_META_BEFORE["$name"]=$(stat -c '%U:%G:%a' "$APP/data/$name")
    REQUIRED_MUTABLE_FILES="${REQUIRED_MUTABLE_FILES}${name},"
  fi
done
# Global block store (Constructor V2). It exists only if a trainer already saved a block:
# it is written by an explicit block save, never at boot. If it exists it must be in the backup and survive the deploy untouched.
BLOCKS_FILE="$APP/data/blocks.json"
BLOCKS_BEFORE=absent
if [[ -e "$BLOCKS_FILE" ]]; then
  test -s "$BLOCKS_FILE"
  tar -tzf "$BACKUP" data/blocks.json >/dev/null
  BLOCKS_BEFORE=present
fi
# Guided routine store (Guided Routines V1: admin overlays, admin-made official routines, trainers'
# own routines, collection edits). It is written only by an explicit guided save/curate/collection
# call, never at boot. b890a26 writes it only when an admin curated or a trainer saved/duplicated a
# guided routine; if it exists it is kept exactly (backup + hash + owner/mode), never replaced.
GUIDED_FILE="$APP/data/guided.json"
GUIDED_BEFORE=absent
if [[ -e "$GUIDED_FILE" ]]; then
  test -s "$GUIDED_FILE"
  tar -tzf "$BACKUP" data/guided.json >/dev/null
  GUIDED_BEFORE=present
fi
# Library admin overlay (Sprint 4.5). It does not exist in production before this release and is created
# only by the first admin edit, never at boot or on read; if it exists it is kept exactly (backup + shape).
LIBADMIN_FILE="$APP/data/library-admin.json"
LIBADMIN_BEFORE=absent
if [[ -e "$LIBADMIN_FILE" ]]; then
  test -s "$LIBADMIN_FILE"
  tar -tzf "$BACKUP" data/library-admin.json >/dev/null
  LIBADMIN_BEFORE=present
fi
# Home news / notices (news.json): admin-authored, written only by an explicit save, never at boot. If it exists
# it is in the backup and must come out of the deploy byte-identical; if it does not, it is created by the first save.
NEWS_FILE="$APP/data/news.json"
NEWS_BEFORE=absent
NEWS_SHA_BEFORE=none
if [[ -e "$NEWS_FILE" ]]; then
  test -s "$NEWS_FILE"
  tar -tzf "$BACKUP" data/news.json >/dev/null
  NEWS_BEFORE=present
  NEWS_SHA_BEFORE=$(sha256sum "$NEWS_FILE" | awk '{print $1}')
fi
# App features (features.json): the admin's module switches. It is data, not release content: never in the archive, never written at boot,
# written only by an explicit admin save. If it exists it is in the backup and must come out byte-identical; if it does not exist
# everything stays ON (the safe default) and the first admin change creates it.
FEATURES_FILE="$APP/data/features.json"
FEATURES_BEFORE=absent
FEATURES_SHA_BEFORE=none
if [[ -e "$FEATURES_FILE" ]]; then
  test -s "$FEATURES_FILE"
  "${COMPOSE[@]}" exec -T api node -e 'const j=JSON.parse(require("fs").readFileSync("/data/features.json","utf8")); if(!j||typeof j!=="object"||(j.off!==undefined&&!Array.isArray(j.off))) process.exit(1)'
  tar -tzf "$BACKUP" data/features.json >/dev/null
  FEATURES_BEFORE=present
  FEATURES_SHA_BEFORE=$(sha256sum "$FEATURES_FILE" | awk '{print $1}')
fi
# Gym-wide official equipment is persistent data (not release content); snapshot its exact state.
GYM_PROFILE_FILE="$APP/data/gym-profile.json"
GYM_PROFILE_BEFORE=absent
if [[ -e "$GYM_PROFILE_FILE" ]]; then
  test -s "$GYM_PROFILE_FILE"
  tar -tzf "$BACKUP" data/gym-profile.json >/dev/null
  GYM_PROFILE_BEFORE=present
fi
BACKUP_SHA256=$(sha256sum "$BACKUP" | awk '{print $1}')
BACKUP_FILES=$(tar -tzf "$BACKUP" | grep -vc '/$' || true)
DATA_TOP_BEFORE=$(find "$APP/data" -mindepth 1 -maxdepth 1 -printf '%f\n' | grep -vE '^state-.*\.json$|\.tmp$' | sort | tr '\n' ' ')
printf 'BACKUP_OK=%s\n' "$BACKUP"
printf 'BACKUP_SHA256=%s files=%s\n' "$BACKUP_SHA256" "$BACKUP_FILES"
printf 'BACKUP_SECRET_SHA256=%s\n' "$SECRET_HASH_BEFORE"
printf 'BACKUP_IMMUTABLES=secret,.env,vapid:%s data_dir_id=%s\n' "$VAPID_BEFORE" "$DATA_DIR_ID_BEFORE"
printf 'BACKUP_BLOCKS_JSON=%s\n' "$BLOCKS_BEFORE"
printf 'BACKUP_GUIDED_JSON=%s\n' "$GUIDED_BEFORE"
printf 'BACKUP_LIBRARY_ADMIN_JSON=%s\n' "$LIBADMIN_BEFORE"
printf 'BACKUP_NEWS_JSON=%s sha256=%s\n' "$NEWS_BEFORE" "$NEWS_SHA_BEFORE"
printf 'BACKUP_FEATURES_JSON=%s sha256=%s\n' "$FEATURES_BEFORE" "$FEATURES_SHA_BEFORE"
printf 'DATA_FILES_BEFORE=%s\n' "$DATA_TOP_BEFORE"
printf 'BACKUP_STATE_FILES=%s\n' "$STATE_COUNT"
printf 'DATA_META=owner:%s mode:%s secret:%s db:%s live_states:%s\n' "$DATA_OWNER_BEFORE" "$DATA_MODE_BEFORE" "$SECRET_META_BEFORE" "$DB_META_BEFORE" "$LIVE_STATE_BEFORE"

STEP=install-release
DEPLOY_STARTED=1
remove_obsolete_release_files "$ROLLBACK" "$RELEASE"
tar -xzf "$RELEASE" -C "$APP"
chown_archive_files "$RELEASE"
printf '%s\n' "$TARGET_COMMIT" > "$APP/.deployed-commit"
cd "$APP"
grep -Fq "$SYNC_BASE" SYNC_V2_ROLLBACK_BASE

verify_archive_tree "$RELEASE"
printf 'INSTALL_TREE=exact\n'

STEP=docker-build-up
"${COMPOSE[@]}" up -d --build

STEP=health-internal
INTERNAL_STATUS=$(wait_status 200 "http://127.0.0.1:$WEB_PORT/api/health" /tmp/2j-internal-body /tmp/2j-internal-headers "$READINESS_TIMEOUT_SEC")
awk 'index($0,"\"ok\":true") {found=1} END {exit !found}' /tmp/2j-internal-body

STEP=health-external
EXTERNAL_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/api/health /tmp/2j-external-body /tmp/2j-external-headers "$READINESS_TIMEOUT_SEC")
awk 'index($0,"\"ok\":true") {found=1} END {exit !found}' /tmp/2j-external-body

STEP=bunker-live-smoke
for action in active finish handoff; do
  BUNKER_ROUTE_STATUS=$(wait_status 401 "https://app.2jfitnesscenter.com/api/bunker/$action" "/tmp/2j-bunker-$action-body" "/tmp/2j-bunker-$action-headers" "$SMOKE_TIMEOUT_SEC" '' POST '{}')
  printf 'BUNKER_ROUTE=OK action=%s status=%s no_credentials_no_mutation\n' "$action" "$BUNKER_ROUTE_STATUS"
done
STEP=auth-smoke
AUTH_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/api/login/options /tmp/2j-auth-body /tmp/2j-auth-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
printf 'AUTH=OK passkey_options=%s no_registration_no_login\n' "$AUTH_STATUS"
STEP=ai-intelligence-smoke
# Import and exercise only pure classifiers in the deployed Node 22 image. No provider call.
"${COMPOSE[@]}" exec -T api node --input-type=module - <<'JS'
import { classify, invokeWithRetry } from '/app/coach/ai-run.js';
import { readStream } from '/app/coach/adapters/claude.js';
import { compactSignal, explainSignal } from '/app/coach/intelligence.js';
import { claimExplanation } from '/app/coach/jobs.js';
import '/app/coach/trainer-jobs.js';
if ([invokeWithRetry, explainSignal, claimExplanation].some(x => typeof x !== 'function')) process.exit(1);
const failed = await readStream((async function* () { yield { type: 'result', subtype: 'success', is_error: true, api_error_status: 529, result: 'overloaded' }; })());
const retry = classify(failed);
if (failed.status !== 529 || retry.ok || !retry.transient || retry.errorClass !== 'provider') process.exit(2);
const denied = classify({ code: 1, text: '', stderr: 'HTTP 401 unauthorized', status: 401 });
if (denied.ok || denied.transient || denied.errorClass !== 'auth') process.exit(3);
const signal = compactSignal({ type: 'PLATEAU', facts: { sessions: 3, health: 'private', community: 'private' } });
if (JSON.stringify(signal) !== '{"type":"PLATEAU","facts":{"sessions":3}}') process.exit(4);
console.log('AI_INTELLIGENCE_RUNTIME=OK retry_529 auth_401 coach_jobs trainer_jobs explanation_minimal');
JS
COACH_EXPLAIN_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/coach/intelligence/explain /tmp/2j-coach-explain-body /tmp/2j-coach-explain-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
COACH_PLAN_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/coach/plan /tmp/2j-coach-plan-body /tmp/2j-coach-plan-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
ADMIN_HISTORY_STATUS=$(wait_status 401 'https://app.2jfitnesscenter.com/api/admin/user?id=smoke' /tmp/2j-admin-history-body /tmp/2j-admin-history-headers "$SMOKE_TIMEOUT_SEC")
printf 'AI_INTELLIGENCE_AUTH=OK explain=%s plan=%s admin_history=%s no_provider_call\n' "$COACH_EXPLAIN_STATUS" "$COACH_PLAN_STATUS" "$ADMIN_HISTORY_STATUS"

STEP=data-sync-smoke
DATA_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/data /tmp/2j-data-body /tmp/2j-data-headers "$SMOKE_TIMEOUT_SEC")
SYNC_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/sync /tmp/2j-sync-body /tmp/2j-sync-headers "$SMOKE_TIMEOUT_SEC")
test -s "$APP/data/db.json"
test -s "$APP/data/secret"
[[ "$(sha256sum "$APP/data/secret" | awk '{print $1}')" == "$SECRET_HASH_BEFORE" ]]
[[ "$(stat -c '%U:%G' "$APP/data")" == "$DATA_OWNER_BEFORE" ]]
[[ "$(stat -c '%a' "$APP/data")" == "$DATA_MODE_BEFORE" ]]
[[ "$(stat -c '%U:%G:%a' "$APP/data/secret")" == "$SECRET_META_BEFORE" ]]
[[ "$(stat -c '%U:%G:%a' "$APP/data/db.json")" == "$DB_META_BEFORE" ]]
LIVE_STATE_AFTER=$(find "$APP/data" -maxdepth 1 -name 'state-*.json' | wc -l)
(( LIVE_STATE_AFTER >= LIVE_STATE_BEFORE ))
[[ "$(stat -c '%d:%i' "$APP/data")" == "$DATA_DIR_ID_BEFORE" ]]
[[ "$(sha256sum "$APP/.env" | awk '{print $1}')" == "$ENV_HASH_BEFORE" ]]
if [[ "$VAPID_BEFORE" == present ]]; then
  [[ "$(sha256sum "$APP/data/vapid.json" | awk '{print $1}')" == "$VAPID_HASH_BEFORE" ]]
fi
BLOCKS_AFTER=$([[ -f "$BLOCKS_FILE" ]] && printf 'present-live-validating' || printf 'absent')
GUIDED_AFTER=$([[ -f "$GUIDED_FILE" ]] && printf 'present-live-validating' || printf 'absent')
GYM_PROFILE_AFTER=$([[ -f "$GYM_PROFILE_FILE" ]] && printf 'present-live-validating' || printf 'absent-fallback')

STEP=inactivity-endpoints-smoke
for action in activity finish-inactive; do
  status=$(wait_status 401 "https://app.2jfitnesscenter.com/api/active/$action" \
    "/tmp/2j-inactive-$action-body" "/tmp/2j-inactive-$action-headers" "$SMOKE_TIMEOUT_SEC" '' POST '{}')
  [[ "$status" == 401 ]]
done
printf 'INACTIVITY_ENDPOINTS=OK unauthenticated_activity+finish=401\n'
STEP=gym-profile-v11-smoke
GYM_CONFIG_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/api/config /tmp/2j-community-config-body /tmp/2j-community-config-headers "$SMOKE_TIMEOUT_SEC")
awk 'index($0,"\"gymProfile\"") && index($0,"\"availableEquipment\"") {found=1} END {exit !found}' /tmp/2j-community-config-body
GYM_ADMIN_WRITE_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/gym-profile/official \
  /tmp/2j-community-admin-body /tmp/2j-community-admin-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
[[ "$GYM_ADMIN_WRITE_STATUS" == 401 || "$GYM_ADMIN_WRITE_STATUS" == 403 ]]
if grep -Eq '"(availableEquipment|gymProfile|ok)"' /tmp/2j-community-admin-body; then printf 'GYM_ADMIN_UNAUTH_RESPONSE_EXPOSED\n'; false; fi

printf 'GYM_PROFILES_V11_RUNTIME=OK config=%s get=%s unauthenticated_write=%s\n' "$GYM_PROFILE_BEFORE" "$GYM_CONFIG_STATUS" "$GYM_ADMIN_WRITE_STATUS"
STEP=health-fitness-api-smoke
# Health V2 / Seguimiento V2 / WHOOP workouts (regression): a 401 without a session proves they
# stay protected. Nothing is created.
WHOOP_WORKOUTS_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/whoop/workouts /tmp/2j-whoop-workouts-body /tmp/2j-whoop-workouts-headers "$SMOKE_TIMEOUT_SEC")
WHOOP_RECOVERY_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/whoop/recovery /tmp/2j-whoop-recovery-body /tmp/2j-whoop-recovery-headers "$SMOKE_TIMEOUT_SEC")
FOLLOWUP_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/followup /tmp/2j-followup-body /tmp/2j-followup-headers "$SMOKE_TIMEOUT_SEC")
ADMIN_FOLLOWUP_STATUS=$(wait_status 401 'https://app.2jfitnesscenter.com/api/admin/user/followup?id=smoke' /tmp/2j-admin-followup-body /tmp/2j-admin-followup-headers "$SMOKE_TIMEOUT_SEC")
ADMIN_FOLLOWUP_POST_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/user/followup \
  /tmp/2j-admin-followup-post-body /tmp/2j-admin-followup-post-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
ADMIN_REVIEW_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/user/review \
  /tmp/2j-admin-review-body /tmp/2j-admin-review-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
BUNKER_SESSION_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/bunker/session /tmp/2j-bunker-session-body /tmp/2j-bunker-session-headers "$SMOKE_TIMEOUT_SEC")
for f in /tmp/2j-whoop-workouts-body /tmp/2j-whoop-recovery-body /tmp/2j-followup-body /tmp/2j-admin-followup-body \
  /tmp/2j-admin-followup-post-body /tmp/2j-admin-review-body /tmp/2j-bunker-session-body; do
  # A negated `! grep` would be ignored by set -e and the ERR trap: fail explicitly instead.
  if grep -Eqi 'token|whoopAuth|hrMax|checkins|workouts|summary' "$f"; then printf 'PRIVACY_LEAK=%s\n' "$f"; false; fi
done

STEP=constructor-protocol-smoke
# Block library API (regression): a 401 without a session proves it is still not public. Every POST carries an empty body and is rejected by
# requireTrainer before the body is read: no block, routine or favourite is created or changed.
BLOCKS_GET_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/blocks /tmp/2j-blocks-get-body /tmp/2j-blocks-get-headers "$SMOKE_TIMEOUT_SEC")
BLOCKS_POST_STATUSES=''
for action in save duplicate active delete favorite; do
  status=$(wait_status 401 "https://app.2jfitnesscenter.com/api/blocks/$action" \
    "/tmp/2j-blocks-$action-body" "/tmp/2j-blocks-$action-headers" "$SMOKE_TIMEOUT_SEC" '' POST '{}')
  BLOCKS_POST_STATUSES="$BLOCKS_POST_STATUSES $action=$status"
done
MEMBER_ROUTINE_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/trainer/member-routine \
  /tmp/2j-member-routine-body /tmp/2j-member-routine-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
MEMBER_PROGRAM_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/trainer/member-program \
  /tmp/2j-member-program-body /tmp/2j-member-program-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
for f in /tmp/2j-blocks-get-body /tmp/2j-blocks-save-body /tmp/2j-blocks-duplicate-body /tmp/2j-blocks-active-body \
  /tmp/2j-blocks-delete-body /tmp/2j-blocks-favorite-body /tmp/2j-member-routine-body /tmp/2j-member-program-body; do
  if grep -Eqi '"(blocks|official|personal|overrides|favorites|officialCustom|seed|uid|canEditOfficial|routineId|validation)"|off-' "$f"; then
    printf 'BLOCKS_LEAK=%s\n' "$f"; false
  fi
done
# Deployed code inside the running api image (read-only; see write_protocol_probe).
PROBE_FILE=$(mktemp /tmp/2j-protocol-probe.XXXXXX)
write_protocol_probe "$PROBE_FILE"
PROBE_OUT=''
PROBE_OUT=$("${COMPOSE[@]}" exec -T api node --input-type=module < "$PROBE_FILE" 2>&1) || { printf '%s\n' "$PROBE_OUT"; false; }
rm -f -- "$PROBE_FILE"
printf '%s\n' "$PROBE_OUT"
printf '%s\n' "$PROBE_OUT" | grep -Fxq 'PROBE_OK'
if [[ "$BLOCKS_BEFORE" == present ]]; then
  "${COMPOSE[@]}" exec -T api node -e 'JSON.parse(require("fs").readFileSync("/data/blocks.json","utf8"))'
fi
[[ "$(sha256sum "$APP/data/secret" | awk '{print $1}')" == "$SECRET_HASH_BEFORE" ]]

STEP=guided-smoke
# Entrena con 2J API: without a session the catalogue is 401 and carries no data; every write,
# curation and collection endpoint is refused (requireTrainer / requireAdmin) before its body is
# read, so an empty POST creates, changes or curates nothing.
GUIDED_GET_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/guided /tmp/2j-guided-get-body /tmp/2j-guided-get-headers "$SMOKE_TIMEOUT_SEC")
GUIDED_POST_STATUSES=''
for action in save duplicate active delete curate collection; do
  status=$(wait_status 401 "https://app.2jfitnesscenter.com/api/guided/$action" \
    "/tmp/2j-guided-$action-body" "/tmp/2j-guided-$action-headers" "$SMOKE_TIMEOUT_SEC" '' POST '{}')
  GUIDED_POST_STATUSES="$GUIDED_POST_STATUSES $action=$status"
done
for f in /tmp/2j-guided-get-body /tmp/2j-guided-save-body /tmp/2j-guided-duplicate-body /tmp/2j-guided-active-body \
  /tmp/2j-guided-delete-body /tmp/2j-guided-curate-body /tmp/2j-guided-collection-body; do
  if grep -Eqi '"(routines|collections|mine|seed|uid|canEdit|canAssign|personal|overrides|officialCustom|validation)"|r2j-|c2j-|off-' "$f"; then
    printf 'GUIDED_LEAK=%s\n' "$f"; false
  fi
done
# Live trainer activity may update these stores while the smoke runs; validate shape below.
if [[ "$GUIDED_BEFORE" == present ]]; then
  "${COMPOSE[@]}" exec -T api node -e 'JSON.parse(require("fs").readFileSync("/data/guided.json","utf8"))'
fi
[[ "$(sha256sum "$APP/data/secret" | awk '{print $1}')" == "$SECRET_HASH_BEFORE" ]]
PROBE_FIELD() { printf '%s' "$PROBE_OUT" | tr ' ' '\n' | awk -F= -v k="$1" '$1 == k {print $2; exit}'; }

STEP=studio-admin-smoke
# Entrena con 2J Studio and Library Admin: every new write is admin-only and refused before its body is
# read (401 without a session, no data in the answer). Nothing is created, changed or curated.
STUDIO_POST_STATUSES=''
for action in status reorder program/save program/curate program/duplicate program/delete collection/delete; do
  status=$(wait_status 401 "https://app.2jfitnesscenter.com/api/guided/$action" /tmp/2j-studio-body /tmp/2j-studio-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
  [[ "$status" == 401 ]]
  if grep -Eqi '"(routines|collections|programs|mine|seed|overrides|validation|program|routine)"|r2j-|c2j-|g2j-' /tmp/2j-studio-body; then printf 'STUDIO_LEAK=%s\n' "$action"; false; fi
  STUDIO_POST_STATUSES="$STUDIO_POST_STATUSES $action=$status"
done
LIBADMIN_GET_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/library /tmp/2j-libadmin-get-body /tmp/2j-libadmin-get-headers "$SMOKE_TIMEOUT_SEC")
LIBADMIN_POST_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/library/save /tmp/2j-libadmin-post-body /tmp/2j-libadmin-post-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
for f in /tmp/2j-libadmin-get-body /tmp/2j-libadmin-post-body; do
  if grep -Eqi '"(overlay|entries|variants|note)"' "$f"; then printf 'LIBADMIN_LEAK=%s\n' "$f"; false; fi
done
[[ "$(sha256sum "$APP/data/secret" | awk '{print $1}')" == "$SECRET_HASH_BEFORE" ]]

STEP=guided-rev-overlay-smoke
# /api/config is public: it carries the catalogue revision (cache invalidation) and the library overlay
# without curatorial notes. A server without library-admin.json answers the empty overlay (rev 0).
REVCFG_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/api/config /tmp/2j-revcfg-body /tmp/2j-revcfg-headers "$SMOKE_TIMEOUT_SEC")
grep -Eq '"guidedRev"[[:space:]]*:[[:space:]]*"[0-9]+\.[0-9]+\.[0-9]+"' /tmp/2j-revcfg-body
grep -Eq '"libraryOverlay"[[:space:]]*:[[:space:]]*\{' /tmp/2j-revcfg-body
if grep -Eqi '"note"' /tmp/2j-revcfg-body; then printf 'OVERLAY_NOTE_LEAK\n'; false; fi
if [[ "$LIBADMIN_BEFORE" == absent ]]; then grep -Eq '"rev"[[:space:]]*:[[:space:]]*0' /tmp/2j-revcfg-body; fi
GUIDED_REV=$(tr -d '\n ' < /tmp/2j-revcfg-body | grep -oE '"guidedRev":"[0-9.]+"' | head -1)
LIBADMIN_AFTER=$([[ -f "$APP/data/library-admin.json" ]] && printf present || printf absent)
[[ "$LIBADMIN_AFTER" == "$LIBADMIN_BEFORE" ]]
printf 'GUIDED_REV_OVERLAY=OK config=%s %s library_admin_json=%s->%s no_note_in_public_overlay\n' "$REVCFG_STATUS" "$GUIDED_REV" "$LIBADMIN_BEFORE" "$LIBADMIN_AFTER"

STEP=bunker-smoke
BUNKER_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/api/bunker/board /tmp/2j-bunker-body /tmp/2j-bunker-headers "$SMOKE_TIMEOUT_SEC")
awk 'index($0,"\"sessions\"") && index($0,"\"todayPrs\"") {found=1} END {exit !found}' /tmp/2j-bunker-body
BUNKER_SETTINGS_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/api/bunker/settings /tmp/2j-bunker-settings-body /tmp/2j-bunker-settings-headers "$SMOKE_TIMEOUT_SEC")
# Privacy: the public gym screen never carries fitness/health fields (key names only, nothing printed).
HEALTH_KEYS='"(fitness|hrZones|avgHr|calories|checkins|shareCheckins|hrMax|measurements|bodyweight|sleep|restingHR)"'
if grep -Eq "$HEALTH_KEYS" /tmp/2j-bunker-body; then printf 'PRIVACY_LEAK=bunker-board\n'; false; fi
if grep -Eq "$HEALTH_KEYS" /tmp/2j-bunker-settings-body; then printf 'PRIVACY_LEAK=bunker-settings\n'; false; fi
# V2.1: when members are checked in right now, each card carries its rest length (read-only look;
# no session is created). An empty board is fine: the release-tree check already covered it.
if grep -q '"uid"' /tmp/2j-bunker-body; then grep -q '"restSec"' /tmp/2j-bunker-body || { printf 'BUNKER_REST_SEC_MISSING\n'; false; }; fi

STEP=social-smoke
SOCIAL_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/social/wall /tmp/2j-social-body /tmp/2j-social-headers "$SMOKE_TIMEOUT_SEC")

STEP=community-v2-smoke
FRIENDS_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/friends /tmp/2j-friends-body /tmp/2j-friends-headers "$SMOKE_TIMEOUT_SEC")
FRIENDS_REQUEST_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/friends/request /tmp/2j-friends-request-body /tmp/2j-friends-request-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
FRIENDS_BLOCK_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/friends/block /tmp/2j-friends-block-body /tmp/2j-friends-block-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
FRIENDS_UNBLOCK_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/friends/unblock /tmp/2j-friends-unblock-body /tmp/2j-friends-unblock-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
CHAT_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/chat/threads /tmp/2j-chat-body /tmp/2j-chat-headers "$SMOKE_TIMEOUT_SEC")
CHAT_DIRECT_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/chat/direct /tmp/2j-chat-direct-body /tmp/2j-chat-direct-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
NOTIFICATIONS_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/notifications /tmp/2j-notifications-body /tmp/2j-notifications-headers "$SMOKE_TIMEOUT_SEC")
NOTIFICATION_READ_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/notifications/read /tmp/2j-notification-read-body /tmp/2j-notification-read-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
NOTIFICATION_READ_ALL_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/notifications/read-all /tmp/2j-notification-read-all-body /tmp/2j-notification-read-all-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
SOCIAL_PREFS_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/social/preferences /tmp/2j-social-prefs-body /tmp/2j-social-prefs-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
SOCIAL_SHARE_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/social/shares /tmp/2j-social-share-body /tmp/2j-social-share-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
SOCIAL_REPORT_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/social/reports /tmp/2j-social-report-body /tmp/2j-social-report-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
MODERATION_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/social-reports /tmp/2j-moderation-body /tmp/2j-moderation-headers "$SMOKE_TIMEOUT_SEC")
MODERATION_RESOLVE_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/social-reports/resolve /tmp/2j-moderation-resolve-body /tmp/2j-moderation-resolve-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
for status in "$FRIENDS_STATUS" "$FRIENDS_REQUEST_STATUS" "$FRIENDS_BLOCK_STATUS" "$FRIENDS_UNBLOCK_STATUS" "$CHAT_STATUS" "$CHAT_DIRECT_STATUS" "$NOTIFICATIONS_STATUS" "$NOTIFICATION_READ_STATUS" "$NOTIFICATION_READ_ALL_STATUS" "$SOCIAL_PREFS_STATUS" "$SOCIAL_SHARE_STATUS" "$SOCIAL_REPORT_STATUS" "$MODERATION_STATUS" "$MODERATION_RESOLVE_STATUS"; do [[ "$status" == 401 ]]; done
verify_poststart_data
printf 'COMMUNITY_V2=OK friends=%s requests=%s blocks=%s direct_chat=%s auth_boundary=401\n' "$FRIENDS_STATUS" "$FRIENDS_REQUEST_STATUS" "$FRIENDS_BLOCK_STATUS" "$CHAT_DIRECT_STATUS"
printf 'NOTIFICATIONS=OK inbox=%s read=%s read_all=%s dedupe=release_contract push_opt_in=release_contract\n' "$NOTIFICATIONS_STATUS" "$NOTIFICATION_READ_STATUS" "$NOTIFICATION_READ_ALL_STATUS"
printf 'COMMUNITY_SHARING=OK write=%s references=release_contract export_renderer=release_contract\n' "$SOCIAL_SHARE_STATUS"
printf 'MODERATION=OK report=%s admin_list=%s resolve=%s admin_only=auth_boundary\n' "$SOCIAL_REPORT_STATUS" "$MODERATION_STATUS" "$MODERATION_RESOLVE_STATUS"
printf 'WEB_PUSH=OK infrastructure=existing explicit_opt_in=release_contract device_delivery=pending_real_device\n'
printf 'COMMUNITY_PRIVACY=OK prefs=%s health_excluded=source_contract blocks=%s visibility_revalidated=source_contract\n' "$SOCIAL_PREFS_STATUS" "$FRIENDS_STATUS"
STEP=affected-api-smoke
AUX_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/aux-ai /tmp/2j-aux-body /tmp/2j-aux-headers "$SMOKE_TIMEOUT_SEC")
IMPORT_MATCH_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/exercises/import-match \
  /tmp/2j-import-match-body /tmp/2j-import-match-headers "$SMOKE_TIMEOUT_SEC" '' POST '{"items":[]}')

STEP=pwa-assets-smoke
INDEX_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/ /tmp/2j-index-body /tmp/2j-index-headers "$SMOKE_TIMEOUT_SEC")
MANIFEST_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/manifest.json /tmp/2j-manifest-body /tmp/2j-manifest-headers "$SMOKE_TIMEOUT_SEC")
SW_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/sw.js /tmp/2j-sw-body /tmp/2j-sw-headers "$SMOKE_TIMEOUT_SEC")
ICON192_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/icon-192.png /tmp/2j-icon192-body /tmp/2j-icon192-headers "$SMOKE_TIMEOUT_SEC")
ICON512_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/icon-512.png /tmp/2j-icon512-body /tmp/2j-icon512-headers "$SMOKE_TIMEOUT_SEC")

STEP=news-smoke
NEWS_GET_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/news /tmp/2j-news-get-body /tmp/2j-news-get-headers "$SMOKE_TIMEOUT_SEC")
NEWS_ADMIN_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/news /tmp/2j-news-admin-body /tmp/2j-news-admin-headers "$SMOKE_TIMEOUT_SEC")
NEWS_POST_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/news/save /tmp/2j-news-post-body /tmp/2j-news-post-headers "$SMOKE_TIMEOUT_SEC" '' POST '{}')
for f in /tmp/2j-news-get-body /tmp/2j-news-admin-body /tmp/2j-news-post-body; do
  if grep -Eqi '"(news|title|items)"' "$f"; then printf 'NEWS_LEAK=%s\n' "$f"; false; fi
done
NEWS_AFTER=$([[ -f "$APP/data/news.json" ]] && printf present || printf absent)
[[ "$NEWS_AFTER" == "$NEWS_BEFORE" ]]
if [[ "$NEWS_BEFORE" == present ]]; then [[ "$(sha256sum "$APP/data/news.json" | awk '{print $1}')" == "$NEWS_SHA_BEFORE" ]]; fi
printf 'NEWS=OK anonymous_get=%s admin_get=%s admin_save=%s news_json=%s->%s unchanged=yes\n' "$NEWS_GET_STATUS" "$NEWS_ADMIN_STATUS" "$NEWS_POST_STATUS" "$NEWS_BEFORE" "$NEWS_AFTER"

STEP=features-smoke
FEATURES_GET_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/features /tmp/2j-features-get-body /tmp/2j-features-get-headers "$SMOKE_TIMEOUT_SEC")
FEATURES_POST_STATUS=$(wait_status 401 https://app.2jfitnesscenter.com/api/admin/features /tmp/2j-features-post-body /tmp/2j-features-post-headers "$SMOKE_TIMEOUT_SEC" '' POST '{"features":{"coach":false}}')
for f in /tmp/2j-features-get-body /tmp/2j-features-post-body; do
  if grep -Eqi '"(features|coach|social)"' "$f"; then printf 'FEATURES_LEAK=%s\n' "$f"; false; fi
done
FEATURES_AFTER=$([[ -f "$APP/data/features.json" ]] && printf present || printf absent)
[[ "$FEATURES_AFTER" == "$FEATURES_BEFORE" ]]
if [[ "$FEATURES_BEFORE" == present ]]; then [[ "$(sha256sum "$APP/data/features.json" | awk '{print $1}')" == "$FEATURES_SHA_BEFORE" ]]; fi
# Sync V2 runtime on the installed tree (the release-protocol step already enforced the same rules on the release): the client is byte-identical to
# production, and api/lib/sync.js is EXACTLY one of the two owner-approved digests (LF blob / CRLF as shipped). Anything else fails.
cmp -s "$APP/frontend/src/lib/sync-client.js" <(tar -xOf "$ROLLBACK" frontend/src/lib/sync-client.js) || { printf 'SYNC_V2_CHANGED=%s\n' frontend/src/lib/sync-client.js; false; }
SYNC_JS_INSTALLED_SHA256=$(sha256sum "$APP/api/lib/sync.js" | awk '{print $1}')
if [[ "$SYNC_JS_INSTALLED_SHA256" != 8b402562d3a5eccfe7054db5246ca4e9f796b70b24306f9c2f8e0c53470fd586 && "$SYNC_JS_INSTALLED_SHA256" != 6cd72a0fbf910612efba88fa1a56700664e4b3e322103632ae025c1174085859 ]]; then
  printf 'SYNC_V2_CHANGED=%s\n' api/lib/sync.js; false
fi
printf 'FEATURES=OK anonymous_get=%s admin_write=%s features_json=%s->%s unchanged=yes defaults=all_on_without_file sync_v2=client_identical+sync.js_approved_sha256\n' "$FEATURES_GET_STATUS" "$FEATURES_POST_STATUS" "$FEATURES_BEFORE" "$FEATURES_AFTER"

STEP=assetlinks-smoke
AL_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/.well-known/assetlinks.json /tmp/2j-al-body /tmp/2j-al-headers "$SMOKE_TIMEOUT_SEC")
AL_TYPE=$(header_value /tmp/2j-al-headers Content-Type)
case "$AL_TYPE" in application/json*) ;; *) printf 'ASSETLINKS_BAD_CONTENT_TYPE=%s\n' "$AL_TYPE"; false ;; esac
grep -Fq '"package_name": "com.twojfitnesscenter.app"' /tmp/2j-al-body
grep -Fq '0C:BB:BF:6F:26:C1:0C:83:23:54:2C:93:AE:B3:E6:19:44:D2:92:46:56:0A:F8:9D:A6:85:36:0F:7A:83:5E:AC' /tmp/2j-al-body
grep -Fq 'delegate_permission/common.get_login_creds' /tmp/2j-al-body
grep -Fq 'delegate_permission/common.handle_all_urls' /tmp/2j-al-body
DOT_STATUS=$(curl -sS --max-time 15 -D /tmp/2j-aldot-headers -o /tmp/2j-aldot-body -w '%{http_code}' --resolve app.2jfitnesscenter.com.:443:127.0.0.1 https://app.2jfitnesscenter.com./.well-known/assetlinks.json)
DOT_TYPE=$(header_value /tmp/2j-aldot-headers Content-Type)
[[ "$DOT_STATUS" == 200 ]]
case "$DOT_TYPE" in application/json*) ;; *) printf 'ASSETLINKS_DOT_BAD_CONTENT_TYPE=%s\n' "$DOT_TYPE"; false ;; esac
cmp -s /tmp/2j-al-body /tmp/2j-aldot-body
printf 'ASSETLINKS=OK status=%s content_type=%s dot_host_status=%s dot_content_type=%s identical=yes\n' "$AL_STATUS" "$AL_TYPE" "$DOT_STATUS" "$DOT_TYPE"
printf 'DAL_GOOGLE=%s\n' "$(curl -s --max-time 20 'https://digitalassetlinks.googleapis.com/v1/assetlinks:check?source.web.site=https://app.2jfitnesscenter.com&relation=delegate_permission/common.get_login_creds&target.android_app.package_name=com.twojfitnesscenter.app&target.android_app.certificate.sha256_fingerprint=0C:BB:BF:6F:26:C1:0C:83:23:54:2C:93:AE:B3:E6:19:44:D2:92:46:56:0A:F8:9D:A6:85:36:0F:7A:83:5E:AC' | tr -d '\n ' | cut -c1-200 || true)"

STEP=main-asset-smoke
ASSET_READY=0
ASSET=''
STYLE=''
ASSET_STATUS=000
STYLE_STATUS=000
ASSET_DEADLINE=$((SECONDS + SMOKE_TIMEOUT_SEC))
while (( SECONDS < ASSET_DEADLINE )); do
  remaining=$((ASSET_DEADLINE - SECONDS))
  attempt_timeout=$((remaining < 10 ? remaining : 10))
  INDEX_STATUS=$(wait_status 200 https://app.2jfitnesscenter.com/ /tmp/2j-index-body /tmp/2j-index-headers "$attempt_timeout" || true)
  ASSET=$(tr '"' '\n' < /tmp/2j-index-body | awk '/^\/assets\/index-[A-Za-z0-9_-]+\.js$/ {print; exit}')
  STYLE=$(tr '"' '\n' < /tmp/2j-index-body | awk '/^\/assets\/index-[A-Za-z0-9_-]+\.css$/ {print; exit}')
  if [[ -n "$ASSET" && -n "$STYLE" ]]; then
    remaining=$((ASSET_DEADLINE - SECONDS))
    attempt_timeout=$((remaining < 10 ? remaining : 10))
    (( attempt_timeout < 1 )) && attempt_timeout=1
    ASSET_STATUS=$(wait_status 200 "https://app.2jfitnesscenter.com$ASSET" /tmp/2j-asset-body /tmp/2j-asset-headers "$attempt_timeout" gzip || true)
    remaining=$((ASSET_DEADLINE - SECONDS))
    (( remaining > 0 )) || break
    attempt_timeout=$((remaining < 10 ? remaining : 10))
    STYLE_STATUS=$(wait_status 200 "https://app.2jfitnesscenter.com$STYLE" /tmp/2j-style-body /tmp/2j-style-headers "$attempt_timeout" gzip || true)
    if [[ "$ASSET_STATUS" == 200 && "$STYLE_STATUS" == 200 ]] \
      && asset_bodies_ready; then
      ASSET_READY=1
      break
    fi
  fi
  printf 'ASSET_RETRY js=%s js_status=%s css=%s css_status=%s remaining=%ss\n' "$ASSET" "$ASSET_STATUS" "$STYLE" "$STYLE_STATUS" "$((ASSET_DEADLINE - SECONDS))" >&2
  (( SECONDS >= ASSET_DEADLINE )) && break
  sleep "$RETRY_INTERVAL_SEC"
done
[[ "$ASSET_READY" == 1 ]]
printf 'ASSETS=OK js=%s css=%s bodies=nonempty content_types=valid\n' "$ASSET" "$STYLE"
for chunk in StudioAdmin ProgramEditor LibraryQuality; do
  CHUNK_FILE=$(grep -oE "$chunk-[A-Za-z0-9_-]+\.js" /tmp/2j-asset-body | head -1)
  [[ -n "$CHUNK_FILE" ]]
  CHUNK_STATUS=$(wait_status 200 "https://app.2jfitnesscenter.com/assets/$CHUNK_FILE" /tmp/2j-chunk-body /tmp/2j-chunk-headers "$SMOKE_TIMEOUT_SEC")
  [[ -s /tmp/2j-chunk-body ]]
done
printf 'STUDIO_CHUNKS=OK lazy admin chunks served status=%s\n' "$CHUNK_STATUS"
printf 'GYM_PROFILES_UI_ASSETS=OK js=picker+active+equipment css=cards+chips+settings_info\n'

STEP=headers-gzip-cache
INDEX_CACHE=$(header_value /tmp/2j-index-headers Cache-Control)
INDEX_NOSNIFF=$(header_value /tmp/2j-index-headers X-Content-Type-Options)
INDEX_FRAME=$(header_value /tmp/2j-index-headers X-Frame-Options)
INDEX_REFERRER=$(header_value /tmp/2j-index-headers Referrer-Policy)
INDEX_HSTS=$(header_value /tmp/2j-index-headers Strict-Transport-Security)
ASSET_CACHE=$(header_value /tmp/2j-asset-headers Cache-Control)
ASSET_ENCODING=$(header_value /tmp/2j-asset-headers Content-Encoding)
STYLE_CACHE=$(header_value /tmp/2j-style-headers Cache-Control)
STYLE_ENCODING=$(header_value /tmp/2j-style-headers Content-Encoding)
[[ "$INDEX_CACHE" == *no-cache* ]]
[[ "$INDEX_NOSNIFF" == nosniff ]]
[[ "$INDEX_FRAME" == SAMEORIGIN ]]
[[ "$INDEX_REFERRER" == strict-origin-when-cross-origin ]]
[[ "$INDEX_HSTS" == *max-age=31536000* ]]
[[ "$ASSET_CACHE" == *max-age=31536000* && "$ASSET_CACHE" == *immutable* ]]
[[ "$ASSET_ENCODING" == gzip ]]
[[ "$STYLE_CACHE" == *max-age=31536000* && "$STYLE_CACHE" == *immutable* ]]
[[ "$STYLE_ENCODING" == gzip ]]
printf 'GZIP=OK js=%s css=%s\n' "$ASSET_ENCODING" "$STYLE_ENCODING"
printf 'CACHE=OK index=%s js=%s css=%s\n' "$INDEX_CACHE" "$ASSET_CACHE" "$STYLE_CACHE"
printf 'HEADERS=OK nosniff=%s frame=%s referrer=%s hsts=%s\n' "$INDEX_NOSNIFF" "$INDEX_FRAME" "$INDEX_REFERRER" "$INDEX_HSTS"

STEP=services
RUNNING=$(wait_services "$READINESS_TIMEOUT_SEC")
"${COMPOSE[@]}" ps

STEP=finalize
verify_archive_tree "$RELEASE"
[[ "$(cat "$APP/.deployed-commit")" == "$TARGET_COMMIT" ]]
printf 'DEPLOY_OK=%s\n' "$TARGET_COMMIT"
printf 'ROLLBACK=NOT_NEEDED\n'
printf 'HEALTH=OK internal=%s external=%s\n' "$INTERNAL_STATUS" "$EXTERNAL_STATUS"
printf 'DATA=OK status=%s immutable_hashes_unchanged owner=%s mode=%s live_states=%s->%s blocks_json=%s guided_json=%s gym_profile=%s mutable_json_valid backup=%s\n' "$DATA_STATUS" "$DATA_OWNER_BEFORE" "$DATA_MODE_BEFORE" "$LIVE_STATE_BEFORE" "$LIVE_STATE_AFTER" "$BLOCKS_AFTER" "$GUIDED_AFTER" "$GYM_PROFILE_AFTER" "$BACKUP"
printf 'PROTOCOL=OK v1.0 runtime_copy_in_sync(9) docs_present gate=restriction_unverified\n'
printf 'BLOCK_LIBRARY=OK masters=%s pass=%s pass_with_reason=%s no_fail no_unverified no_duplicate_ids no_duplicate_content api_blocks=%s seed_read_from_release blocks_json=%s\n' \
  "$(PROBE_FIELD masters)" "$(PROBE_FIELD pass)" "$(PROBE_FIELD pass_with_reason)" "$(PROBE_FIELD api_blocks)" "$BLOCKS_AFTER"
printf 'GUIDED_LIBRARY=OK guided_masters=%s masters_used_by_routines=%s copies_in_routines=%s not_in_api_blocks\n' \
  "$(PROBE_FIELD guided_masters)" "$(PROBE_FIELD masters_used)" "$(PROBE_FIELD copies)"
printf 'GUIDED_ROUTINES=OK routines=%s all_pass no_pass_with_reason stable_ids facts_recomputed ai_offered seed_read_from_release guided_json=%s\n' "$(PROBE_FIELD routines)" "$GUIDED_AFTER"
printf 'COLLECTIONS=OK collections=%s featured=%s refs_valid\n' "$(PROBE_FIELD collections)" "$(PROBE_FIELD featured)"
printf 'GUIDED_PROGRAMS=OK programs=%s week_session_refs_valid admin_curation_present\n' "$(PROBE_FIELD programs)"
printf 'TRAIN2J=OK guided_get=%s posts=[%s ] routes=/train2j,/train2j/c/:id,/train2j/r/:id,/trainer/guided covers=svg start=free_session_snapshot history=src2j favorites=g2j_favs:<uid> offline=g2j_catalog:<uid>\n' "$GUIDED_GET_STATUS" "$GUIDED_POST_STATUSES"
printf 'PERMISSIONS=OK read=session writes=trainer(4) curate+collections+programs+library=admin_only own_only fail_never_stored member_writes=%s (api tests %s/%s)\n' "$(PROBE_FIELD member_writes)" @@API_PASSED@@ @@API_TESTS@@
printf 'TREADMILL=OK 0684+3666 eq=treadmill same_id/media 0684=treadmill_run blocks=6 routines=8 not_no_equipment no_override\n'
printf 'LEGAL=OK license=AGPL-3.0-or-later(unmodified_text) original=openGym/Duarte_Santos fork=Juan_Jose_Perez_Sanchez/2J_Fitness_Center notices=NOTICE,AUTHORS,TRADEMARKS,THIRD_PARTY headers=210 legal_screen=bundle source=github.com/2jfitnesscenter/2jfitnessapp\n'
printf 'EXERCISE_LIBRARY_V2=OK exercises=%s recommended=%s with_movement=%s deprecated=%s dup_groups=0 aliases=102 living_dup_names=0 ids_unchanged no_history_migration\n' \
  "$(PROBE_FIELD exlib)" "$(PROBE_FIELD recommended)" "$(PROBE_FIELD with_movement)" "$(PROBE_FIELD deprecated)"
printf 'EXERCISE_TAXONOMY=OK movements=%s equipment=%s kinds=%s preferred_valid no_chains not_in_official_seeds classifier=bridge/side_bridge/climber/outstretched/wrist/stretch\n' \
  "$(PROBE_FIELD movements)" "$(PROBE_FIELD equipment)" "$(PROBE_FIELD kinds)"
printf 'EXERCISE_SEARCH=OK es/en name+alias+movement+muscle+equipment deprecated_last (tests + bundle)\n'
printf 'EXERCISE_SWAP=OK similar_variants_first reasons max=8 constructor+trainer_builder+workout+bunker(same_sheet)\n'
printf 'EXERCISE_IMPORT=OK spanish_aliases translated_names deprecated_to_preferred ties_not_guessed\n'
printf 'EXERCISE_AI=OK ids=1324 rec_first=%s gym_hidden=%s deprecated_excluded old_ids_validate high_overlap=note_only\n' "$(PROBE_FIELD ai_rec_first)" "$(PROBE_FIELD hidden_ex)"
printf 'GYM_PROFILES_V11=OK equipment=19 source=official_global admin_write=protected offline_cache=yes sync=separate config=%s\n' "$GYM_PROFILE_AFTER"
printf 'GUIDED_BLOCKS=OK circuit/interval/hiit/tabata/mobility rounds=1-10 tabata=editable circuit=time+reps interval_rounds+mobility=not_direct_volume ai=offered validator=authority\n'
printf 'BUNKER_REST=OK prescribed_rest fallback=90s superset_pair guided_timing board_restSec\n'
printf 'RECOMMENDER=OK direct_sets_only suggest_preview_add dismissible (bundle)\n'
printf 'HIP_THRUST=OK id=0058 renamed_in_place glute_bridge=1409 separate no_duplicate\n'
printf 'CONSTRUCTOR_V2=OK get=%s posts=[%s ] member_routine=%s member_program=%s markers=cx/blocks/2J\n' "$BLOCKS_GET_STATUS" "$BLOCKS_POST_STATUSES" "$MEMBER_ROUTINE_STATUS" "$MEMBER_PROGRAM_STATUS"
printf 'SAVE_POLICY=OK restriction=never_overridable methodological_fail=override_with_reason ai_fail=repair_or_discard\n'
printf 'HEALTH_FITNESS_API=OK whoop_workouts=%s whoop_recovery=%s followup=%s admin_followup=%s/%s admin_review=%s bunker_session=%s\n' \
  "$WHOOP_WORKOUTS_STATUS" "$WHOOP_RECOVERY_STATUS" "$FOLLOWUP_STATUS" "$ADMIN_FOLLOWUP_STATUS" "$ADMIN_FOLLOWUP_POST_STATUS" "$ADMIN_REVIEW_STATUS" "$BUNKER_SESSION_STATUS"
printf 'PRIVACY=OK bunker_board_settings_without_health_keys protected_bodies_clean\n'
@@POSTSTART_PROBES@@
printf 'RELEASE_SCOPE=OK SyncV2_unchanged=yes SharedStaff=guarded\n'
printf 'HOME=OK no_body_composition_card health_measurements_keep_it\n'
printf 'SYNC=OK status=%s no_second_sync week/dayPlan/activeProgramId/routines untouched_by_2j_start\n' "$SYNC_STATUS"
printf 'BUNKER=OK board=%s settings=%s\n' "$BUNKER_STATUS" "$BUNKER_SETTINGS_STATUS"
printf 'SOCIAL=OK status=%s\n' "$SOCIAL_STATUS"
printf 'AUX_IMPORT=OK aux=%s import=%s\n' "$AUX_STATUS" "$IMPORT_MATCH_STATUS"
printf 'PWA=OK manifest=%s sw=%s icons=%s/%s\n' "$MANIFEST_STATUS" "$SW_STATUS" "$ICON192_STATUS" "$ICON512_STATUS"
printf 'ASSET=%s status=%s style=%s style_status=%s\n' "$ASSET" "$ASSET_STATUS" "$STYLE" "$STYLE_STATUS"
printf 'STUDIO_ADMIN=OK posts=[%s ] library_get=%s library_post=%s member_writes=%s ai_deprecated=%s overlay_rev=%s %s\n' "$STUDIO_POST_STATUSES" "$LIBADMIN_GET_STATUS" "$LIBADMIN_POST_STATUS" "$(PROBE_FIELD member_writes)" "$(PROBE_FIELD ai_deprecated)" "$(PROBE_FIELD overlay_rev)" "$GUIDED_REV"
printf 'SERVICES=OK api,web,caddy\n'
printf 'LOG=%s\n' "$LOG"
'@

function Render-RemoteCommitAssignments {
  param([string]$Template, [string]$Target, [string]$Rollback)
  $Template = $Template -replace "`r`n?", "`n"
  if ($Target -cnotmatch '^[0-9a-f]{40}$') { throw 'TARGET_COMMIT_MUST_BE_FULL_LOWERCASE_SHA40' }
  if ($Rollback -cnotmatch '^[0-9a-f]{40}$') { throw 'ROLLBACK_COMMIT_MUST_BE_FULL_LOWERCASE_SHA40' }
  if ([regex]::Matches($Template, '(?m)^TARGET_COMMIT=__TARGET_COMMIT__$').Count -ne 1) { throw 'TARGET_COMMIT_TEMPLATE_TOKEN_INVALID' }
  if ([regex]::Matches($Template, '(?m)^ROLLBACK_COMMIT=__ROLLBACK_COMMIT__$').Count -ne 1) { throw 'ROLLBACK_COMMIT_TEMPLATE_TOKEN_INVALID' }
  $rendered = $Template.Replace('TARGET_COMMIT=__TARGET_COMMIT__', "TARGET_COMMIT=$Target").Replace('ROLLBACK_COMMIT=__ROLLBACK_COMMIT__', "ROLLBACK_COMMIT=$Rollback")
  $targetLine = [regex]::Match($rendered, '(?m)^TARGET_COMMIT=([0-9a-f]{40})$')
  $rollbackLine = [regex]::Match($rendered, '(?m)^ROLLBACK_COMMIT=([0-9a-f]{40})$')
  if (-not $targetLine.Success -or $targetLine.Groups[1].Value -cne $Target) { throw 'REMOTE_TARGET_COMMIT_MISMATCH' }
  if (-not $rollbackLine.Success -or $rollbackLine.Groups[1].Value -cne $Rollback) { throw 'REMOTE_ROLLBACK_COMMIT_MISMATCH' }
  if ([regex]::Matches($rendered, '(?m)^TARGET_COMMIT=').Count -ne 1 -or [regex]::Matches($rendered, '(?m)^ROLLBACK_COMMIT=').Count -ne 1) { throw 'REMOTE_COMMIT_ASSIGNMENT_DUPLICATED' }
  return $rendered
}

# Regression test for the historical short-SHA substring corruption.
$OldFullSha = '0b34b9bbc5584c345d91727e93007fd6f8750b76'
$RegressionNewSha = '16a1bb779140cd28020551bf16c0628f88b46f4f'
$HistoricalCorruption = $OldFullSha.Replace('0b34b9b', '16a1bb7')
if ($HistoricalCorruption -cne '16a1bb7bc5584c345d91727e93007fd6f8750b76') { throw 'HISTORICAL_SHA_CORRUPTION_FIXTURE_INVALID' }
$RegressionTemplate = "TARGET_COMMIT=__TARGET_COMMIT__`nROLLBACK_COMMIT=__ROLLBACK_COMMIT__"
$RegressionOutput = Render-RemoteCommitAssignments -Template $RegressionTemplate -Target $RegressionNewSha -Rollback $OldFullSha
if ($RegressionOutput -cnotmatch ('(?m)^TARGET_COMMIT=' + [regex]::Escape($RegressionNewSha) + '$')) { throw 'FULL_SHA_TEMPLATE_REGRESSION_POSITIVE_FAILED' }
if ($RegressionOutput.Contains('16a1bb7bc5584c345d91727e93007fd6f8750b76')) { throw 'FULL_SHA_TEMPLATE_REGRESSION_CORRUPTED_SHA_PRESENT' }
Write-Host 'RUNNER_SHA_TEMPLATE_REGRESSION=PASS old/new full SHA remain independent'

$RemoteScript = Render-RemoteCommitAssignments -Template $RemoteScriptTemplate -Target $Commit -Rollback $RollbackCommit

$RemoteScript = $RemoteScript.Replace('__EXPECTED_HASH__', $LocalHash)
$RemoteScript = $RemoteScript.Replace('__REMOTE_RELEASE__', $RemoteRelease)
$RemoteScript = $RemoteScript.Replace('__REMOTE_ROLLBACK__', $RemoteRollback)
$RemoteScript = $RemoteScript.Replace('__EXPECTED_ROLLBACK_HASH__', $RollbackHash)
$Utf8NoBom = New-Object System.Text.UTF8Encoding($false)
[System.IO.File]::WriteAllText($LocalRunner, ($RemoteScript -replace "`r`n", "`n"), $Utf8NoBom)

$SimulationScript = @'
#!/usr/bin/env bash
set -Eeuo pipefail
# Codex launches Git Bash with a Windows-only PATH; prefer its Unix tools for this simulation.
export PATH="/usr/bin:/mingw64/bin:$PATH"
wait_status() {
  local expected=$1 url=$2 body=$3 headers=$4
  if [[ "$url" == */api/shared-device/status ]]; then printf '{"authorized":false}\n' > "$body"; else : > "$body"; fi
  : > "$headers"
  printf '%s' "$expected"
}
ROLLBACK=$1
RELEASE=$2
ROLLBACK_COMMIT=$3
TARGET_COMMIT=$4
EXPECTED_ROLLBACK_HASH=$5
EXPECTED_RELEASE_HASH=$6
RUNTIME_PROBE=$7
MUTABLE_PROBE=$8
test -s "$ROLLBACK" && test -s "$RELEASE"
gzip -t "$ROLLBACK" && gzip -t "$RELEASE"
[[ "$(sha256sum "$ROLLBACK" | awk '{print $1}')" == "$EXPECTED_ROLLBACK_HASH" ]]
[[ "$(sha256sum "$RELEASE" | awk '{print $1}')" == "$EXPECTED_RELEASE_HASH" ]]
printf 'SIM_TRANSFER=OK release=%s rollback=%s\n' "$EXPECTED_RELEASE_HASH" "$EXPECTED_ROLLBACK_HASH"
SIM_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/2j-community-deploy-sim.XXXXXX")
trap 'rm -rf -- "$SIM_ROOT"' EXIT
APP=$SIM_ROOT/app
RB_TREE=$SIM_ROOT/rollback-expected
TARGET_TREE=$SIM_ROOT/target-expected
mkdir -p "$APP" "$RB_TREE" "$TARGET_TREE"
tar -xzf "$ROLLBACK" -C "$APP"
tar -xzf "$ROLLBACK" -C "$RB_TREE"
printf '%s\n' "$ROLLBACK_COMMIT" > "$APP/.deployed-commit"
printf 'WEB_PORT=8080\n' > "$APP/.env"
mkdir -p "$APP/data"
printf 'synthetic-secret\n' > "$APP/data/secret"
printf '{"users":[]}\n' > "$APP/data/db.json"
for i in $(seq -w 1 17); do printf '{"workouts":[],"slot":%s}\n' "$i" > "$APP/data/state-$i.json"; done
printf '{"items":[{"id":"notice-synthetic"}],"privacy":{},"preferences":{}}\n' > "$APP/data/notifications.json"
printf '{"threads":[{"id":"chat-synthetic"}],"messages":[]}\n' > "$APP/data/chat.json"
printf '{"codes":[],"requests":[],"blocked":[]}\n' > "$APP/data/friends.json"
printf '{"routines":[],"programs":[],"wall":[],"challenges":[],"goals":[],"topics":[],"board":[]}\n' > "$APP/data/social.json"
printf '{"shares":[{"id":"share-synthetic"}],"reports":[{"id":"report-synthetic"}]}\n' > "$APP/data/social-sharing.json"
printf '{"publicKey":"synthetic","privateKey":"synthetic"}\n' > "$APP/data/vapid.json"
DATA_BEFORE=$(find "$APP/data" -type f -print0 | sort -z | xargs -0 sha256sum)
__VERIFY_CURRENT_PRODUCTION__

run_api_runtime_probe() {
  local source_api=$1 api_path data_path expect=${GYM_CONFIG_EXPECT:-}
  api_path=$(cygpath -m "$source_api")
  data_path=$(cygpath -m "$APP/data")
  PROBE_BASE="file:///$api_path/" DATA_DIR="$data_path" GYM_CONFIG_EXPECT="$expect" node "$RUNTIME_PROBE"
}
run_mutable_probe() {
  local data_path
  data_path=$(cygpath -m "$APP/data")
  DATA_DIR="$data_path" MUTABLE_CRYPTO_MODULE="$(cygpath -m "$TARGET_TREE/api/lib/crypto.js")" REQUIRED_MUTABLE_FILES='db.json,notifications.json,friends.json,chat.json,social.json,social-sharing.json,gym-profile.json' node "$MUTABLE_PROBE"
}

remove_obsolete_release_files() {
  local old_archive=$1 new_archive=$2 old_list new_list
  old_list=$(mktemp "$SIM_ROOT/old.XXXXXX")
  new_list=$(mktemp "$SIM_ROOT/new.XXXXXX")
  tar -tzf "$old_archive" | sort > "$old_list"
  tar -tzf "$new_archive" | sort > "$new_list"
  while IFS= read -r rel; do
    [[ -z "$rel" || "$rel" == */ || "$rel" == data || "$rel" == data/* ]] && continue
    rm -f -- "$APP/$rel"
  done < <(comm -23 "$old_list" "$new_list")
  while IFS= read -r rel; do
    [[ -z "$rel" || "$rel" == data/ || "$rel" == data/* ]] && continue
    [[ -d "$APP/$rel" ]] || continue
    rmdir -- "$APP/$rel" 2>/dev/null || printf 'SIM_ORPHAN_DIR_NOT_EMPTY=%s\n' "$rel" >&2
  done < <(comm -23 "$old_list" "$new_list" | grep '/$' | sort -r || true)
  rm -f -- "$old_list" "$new_list"
}
code_tree() {
  (cd "$1" && find . -mindepth 1 ! -path './data' ! -path './data/*' ! -path './.env' ! -path './.deployed-commit' \
    -printf '%y %m %P %l\n' | sort)
}
code_hashes() {
  (cd "$1" && find . -type f ! -path './data/*' ! -path './.env' ! -path './.deployed-commit' -print0 | sort -z | xargs -0 sha256sum)
}
verify_tree() {
  local expected=$1 label=$2
  diff -u <(code_tree "$expected") <(code_tree "$APP")
  diff -u <(code_hashes "$expected") <(code_hashes "$APP")
  [[ "$(cat "$APP/.deployed-commit")" == "$label" ]]
}

tar -xzf "$RELEASE" -C "$TARGET_TREE"
run_api_runtime_probe "$TARGET_TREE/api"
printf 'SIM_RELEASE_RUNTIME_PROBE=OK gym-profile.json=absent fallback=verified\n'
printf '{"v":1,"availableEquipment":["bodyweight","smith"]}\n' > "$APP/data/gym-profile.json"
DATA_BEFORE=$(find "$APP/data" -type f -print0 | sort -z | xargs -0 sha256sum)
GYM_CONFIG_EXPECT=custom run_api_runtime_probe "$TARGET_TREE/api"
printf 'SIM_GYM_CONFIG=OK absent=fallback present=readable\n'
remove_obsolete_release_files "$ROLLBACK" "$RELEASE"
tar -xzf "$RELEASE" -C "$APP"
printf '%s\n' "$TARGET_COMMIT" > "$APP/.deployed-commit"
verify_tree "$TARGET_TREE" "$TARGET_COMMIT"
run_api_runtime_probe "$APP/api"
printf 'SIM_INSTALLED_RUNTIME_PROBE=OK\n'
printf 'SIM_INSTALL=OK commit=%s exact_tree=yes\n' "$TARGET_COMMIT"
printf '{"items":[{"id":"notice-synthetic","readAt":123}],"privacy":{},"preferences":{}}\n' > "$APP/data/notifications.json"
run_mutable_probe
printf 'SIM_COMMUNITY_LIVE_MUTATION=PASS changed_notifications_json_accepted\n'
cp -p "$APP/data/friends.json" "$SIM_ROOT/friends-original.json"
rm -f -- "$APP/data/friends.json"
if run_mutable_probe >/dev/null 2>&1; then printf 'SIM_MUTABLE_MISSING_NOT_REJECTED\n' >&2; exit 1; fi
cp -p "$SIM_ROOT/friends-original.json" "$APP/data/friends.json"
cp -p "$APP/data/chat.json" "$SIM_ROOT/chat-original.json"
: > "$APP/data/chat.json"
if run_mutable_probe >/dev/null 2>&1; then printf 'SIM_MUTABLE_TRUNCATED_NOT_REJECTED\n' >&2; exit 1; fi
cp -p "$SIM_ROOT/chat-original.json" "$APP/data/chat.json"
cp -p "$APP/data/social-sharing.json" "$SIM_ROOT/shares-original.json"
printf '{\n' > "$APP/data/social-sharing.json"
if run_mutable_probe >/dev/null 2>&1; then printf 'SIM_MUTABLE_CORRUPT_NOT_REJECTED\n' >&2; exit 1; fi
cp -p "$SIM_ROOT/shares-original.json" "$APP/data/social-sharing.json"
# chat.json encrypted at rest (Sprint 3): the probe must ACCEPT a valid encrypted chat and REJECT corrupted ciphertext and a wrong key.
chat_crypto() {
  local data_path crypto_path
  data_path=$(cygpath -m "$APP/data"); crypto_path=$(cygpath -m "$TARGET_TREE/api/lib/crypto.js")
  DATA_DIR="$data_path" CRYPTO_FILE="$crypto_path" CHAT_FILE="$data_path/chat.json" CHAT_ACTION="$1" node --input-type=module -e '
    import fs from "node:fs"; import { pathToFileURL } from "node:url";
    const c = await import(pathToFileURL(process.env.CRYPTO_FILE).href);
    const f = process.env.CHAT_FILE;
    if (process.env.CHAT_ACTION === "encrypt") fs.writeFileSync(f, c.encrypt({ threads: [{ id: "chat-synthetic" }], messages: [{ id: "m-synthetic" }] }, "chat-store"));
    else { const t = fs.readFileSync(f, "utf8"); const i = Math.floor(t.length / 2); fs.writeFileSync(f, t.slice(0, i) + (t[i] === "A" ? "B" : "A") + t.slice(i + 1)); }'
}
chat_crypto encrypt
run_mutable_probe
printf 'SIM_ENCRYPTED_CHAT=PASS valid_ciphertext_accepted\n'
chat_crypto corrupt
if run_mutable_probe >/dev/null 2>&1; then printf 'SIM_ENCRYPTED_CHAT_CORRUPT_NOT_REJECTED\n' >&2; exit 1; fi
chat_crypto encrypt
printf 'different-synthetic-secret\n' > "$APP/data/secret"
if run_mutable_probe >/dev/null 2>&1; then printf 'SIM_ENCRYPTED_CHAT_WRONG_KEY_NOT_REJECTED\n' >&2; exit 1; fi
printf 'synthetic-secret\n' > "$APP/data/secret"
printf 'not-json-and-not-ciphertext {\n' > "$APP/data/chat.json"
if run_mutable_probe >/dev/null 2>&1; then printf 'SIM_PLAINTEXT_CHAT_INVALID_NOT_REJECTED\n' >&2; exit 1; fi
cp -p "$SIM_ROOT/chat-original.json" "$APP/data/chat.json"
printf 'SIM_ENCRYPTED_CHAT_GUARDS=PASS corrupted+wrong_key+invalid_plaintext_rejected\n'
run_mutable_probe
DATA_BEFORE=$(find "$APP/data" -type f -print0 | sort -z | xargs -0 sha256sum)
printf 'SIM_COMMUNITY_CORRUPTION=PASS missing+truncated+invalid_json_rejected\n'
__FINALIZE_SUMMARY__

remove_obsolete_release_files "$RELEASE" "$ROLLBACK"
tar -xzf "$ROLLBACK" -C "$APP"
# The marker is restored and verified by the REAL rollback function (as a failed install leaves it at the target), with a live health answer of 200.
printf '%s\n' "$TARGET_COMMIT" > "$APP/.deployed-commit"
printf 'const http = require("http"); const fs = require("fs"); const s = http.createServer((q, r) => { r.writeHead(200); r.end("{}"); }); s.listen(0, "127.0.0.1", () => fs.writeFileSync(process.argv[2], String(s.address().port)));\n' > "$SIM_ROOT/health-server.cjs"
# node.exe is a Windows program: it cannot resolve Git Bash's /tmp paths, so it gets the same cygpath -m form the other simulation probes use.
node "$(cygpath -m "$SIM_ROOT/health-server.cjs")" "$(cygpath -m "$SIM_ROOT/health-port")" > /dev/null 2>&1 &
HEALTH_PID=$!
for _ in $(seq 1 50); do [[ -s "$SIM_ROOT/health-port" ]] && break; sleep 0.1; done
SIM_HEALTH=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$(cat "$SIM_ROOT/health-port")/api/health" || true)
kill "$HEALTH_PID" 2>/dev/null || true
[[ "$SIM_HEALTH" == 200 ]]
finish_rollback_verification 0 0 0 "$SIM_HEALTH" '' ''
[[ "$(cat "$APP/.deployed-commit")" == "$ROLLBACK_COMMIT" ]]
printf 'SIM_ROLLBACK_MARKER=PASS tree_exact marker=%s health=%s\n' "$ROLLBACK_COMMIT" "$SIM_HEALTH"
# negatives: a rollback whose health is not 200, or whose marker cannot be restored, must NOT report OK
# Each negative case runs in its OWN fresh directory (APP is overridden inside a subshell), so an unwritable marker can never leak into another case or
# into the real simulated tree, and the expected stderr of the failing write is not surfaced (Windows PowerShell treats native stderr as an error).
NEG_HEALTH=$(mktemp -d "$SIM_ROOT/neg-health.XXXXXX")
NEG_MARKER=$(mktemp -d "$SIM_ROOT/neg-marker.XXXXXX")
printf '%s\n' "$TARGET_COMMIT" > "$NEG_HEALTH/.deployed-commit"
if (APP=$NEG_HEALTH; finish_rollback_verification 0 0 0 000 '' '') >/dev/null 2>&1; then printf 'SIM_ROLLBACK_BAD_HEALTH_NOT_REJECTED\n' >&2; exit 1; fi
mkdir "$NEG_MARKER/.deployed-commit"
if (APP=$NEG_MARKER; finish_rollback_verification 0 0 0 200 '' '') >/dev/null 2>&1; then printf 'SIM_ROLLBACK_BAD_MARKER_NOT_REJECTED\n' >&2; exit 1; fi
rmdir "$NEG_MARKER/.deployed-commit"
(APP=$NEG_MARKER; finish_rollback_verification 0 0 0 200 '' '') >/dev/null 2>&1
[[ -f "$NEG_MARKER/.deployed-commit" && "$(cat "$NEG_MARKER/.deployed-commit")" == "$ROLLBACK_COMMIT" ]]
[[ -f "$APP/.deployed-commit" && "$(cat "$APP/.deployed-commit")" == "$ROLLBACK_COMMIT" ]]
printf 'SIM_ROLLBACK_MARKER_GUARDS=PASS bad_health_and_unwritable_marker_rejected isolated_dirs\n'
verify_tree "$RB_TREE" "$ROLLBACK_COMMIT"
DATA_AFTER=$(find "$APP/data" -type f -print0 | sort -z | xargs -0 sha256sum)
[[ "$DATA_AFTER" == "$DATA_BEFORE" ]]
printf 'SIM_ROLLBACK=OK commit=%s exact_tree=yes data=unchanged state_files=17 secret=unchanged gym-profile=preserved notifications/chat/friends/social/shares/reports/vapid=preserved\n' "$ROLLBACK_COMMIT"
'@
$RemoteForExtract = $RemoteScript -replace "`r`n", "`n"
$treeStart = $RemoteForExtract.IndexOf('verify_archive_tree() {')
$treeEnd = $RemoteForExtract.IndexOf('rollback() {', $treeStart)
$archiveTreeFunction = $RemoteForExtract.Substring($treeStart, $treeEnd - $treeStart)
$finalizeStart = $RemoteForExtract.IndexOf('STEP=finalize' + "`n")
if ($finalizeStart -lt 0) { throw 'Could not extract final deployment summary for local simulation' }
$finalizeBlock = $RemoteForExtract.Substring($finalizeStart).TrimEnd()
$finalizePrefix = @'
printf 'SIMULATED_FINALIZE_BEGIN production_mutation=no\n'
INTERNAL_STATUS=200
EXTERNAL_STATUS=200
DATA_STATUS=401
DATA_OWNER_BEFORE=2jfitness:2jfitness
DATA_MODE_BEFORE=700
LIVE_STATE_BEFORE=17
LIVE_STATE_AFTER=17
BLOCKS_AFTER=absent-unchanged
GUIDED_AFTER=absent-unchanged
GYM_PROFILE_AFTER=present-unchanged
BACKUP=/simulation/predeploy.tar.gz
PROBE_OUT='INACTIVITY_MODEL_PROBE=OK deadline=60min passive_no_reset duration_excludes_idle
PROBE_OK
PROBE_DATA exlib=1324 recommended=210 with_movement=1305 deprecated=26 movements=35 equipment=28 kinds=6 ai_rec_first=210 hidden_ex=0 gym_profiles=ok gym_config_source=persisted gym_ai_context=hotel gym_compatible_first=bodyweight protocol=1.0 masters=198 pass=198 pass_with_reason=0 fail=0 unverified=0 api_blocks=198 guided_masters=86 routines=155 programs=22 collections=15 featured=3 masters_used=145 copies=363 member_writes=refused ai_deprecated=0 overlay_rev=0 guided_rev=1.2.0'
GUIDED_GET_STATUS=401
STUDIO_POST_STATUSES='status=401 reorder=401 program/save=401 program/curate=401 program/duplicate=401 program/delete=401 collection/delete=401'
LIBADMIN_GET_STATUS=401
LIBADMIN_POST_STATUS=401
GUIDED_REV='"guidedRev":"1.2.0"'
GUIDED_POST_STATUSES='save=401 duplicate=401 active=401 delete=401 curate=401 collection=401'
BLOCKS_GET_STATUS=401
BLOCKS_POST_STATUSES='save=401 duplicate=401 active=401 delete=401 favorite=401'
MEMBER_ROUTINE_STATUS=401
MEMBER_PROGRAM_STATUS=401
WHOOP_WORKOUTS_STATUS=401
WHOOP_RECOVERY_STATUS=401
FOLLOWUP_STATUS=401
ADMIN_FOLLOWUP_STATUS=401
ADMIN_FOLLOWUP_POST_STATUS=401
ADMIN_REVIEW_STATUS=401
BUNKER_SESSION_STATUS=401
SYNC_STATUS=401
BUNKER_STATUS=200
BUNKER_SETTINGS_STATUS=200
SOCIAL_STATUS=401
AUX_STATUS=401
IMPORT_MATCH_STATUS=401
MANIFEST_STATUS=200
SW_STATUS=200
ICON192_STATUS=200
ICON512_STATUS=200
ASSET=/assets/index-simulated.js
ASSET_STATUS=200
STYLE=/assets/index-simulated.css
STYLE_STATUS=200
LOG=/tmp/simulation.log
PROBE_FIELD() { printf '%s' "$PROBE_OUT" | tr ' ' '\n' | awk -F= -v k="$1" '$1 == k {print $2; exit}'; }
'@
$SimulationScript = $SimulationScript.Replace('__FINALIZE_SUMMARY__', $archiveTreeFunction + "`n" + $finalizePrefix + "`n" + $finalizeBlock)
$currentStart = $RemoteForExtract.IndexOf('STEP=verify-current-production' + "`n")
$currentEnd = $RemoteForExtract.IndexOf('STEP=backup-data' + "`n", $currentStart)
if ($currentStart -lt 0 -or $currentEnd -lt 0) { throw 'Could not extract verify-current-production for local simulation' }
$currentProductionBlock = $RemoteForExtract.Substring($currentStart, $currentEnd - $currentStart)
$currentProductionBlock = $currentProductionBlock -replace '^STEP=verify-current-production\n', ''
if (-not $SimulationScript.Contains('__VERIFY_CURRENT_PRODUCTION__')) { throw 'Simulation precheck placeholder missing' }
$SimulationScript = $SimulationScript.Replace('__VERIFY_CURRENT_PRODUCTION__', $currentProductionBlock)
[System.IO.File]::WriteAllText($SimulationRunner, ($SimulationScript -replace "`r`n", "`n"), $Utf8NoBom)
$GitExe = (Get-Command git.exe -ErrorAction Stop).Source
$GitRoot = Split-Path (Split-Path $GitExe -Parent) -Parent
$Bash = Join-Path $GitRoot 'bin\bash.exe'
if (-not (Test-Path -LiteralPath $Bash)) { throw "Git Bash no encontrado junto a Git: $Bash" }
function ConvertTo-GitBashPath([string]$Path) {
  $full = [System.IO.Path]::GetFullPath($Path)
  $drive = $full.Substring(0, 1).ToLowerInvariant()
  return '/' + $drive + '/' + $full.Substring(3).Replace('\', '/')
}
$RemoteRunnerUnix = ConvertTo-GitBashPath $LocalRunner
& $Bash -n $RemoteRunnerUnix
if ($LASTEXITCODE -ne 0) { throw 'Bash syntax validation failed for the generated remote runner' }
Write-Host 'REMOTE_BASH_SYNTAX=OK'
$protocolStart = $RemoteForExtract.IndexOf('STEP=verify-release-protocol' + "`n")
$protocolEnd = $RemoteForExtract.IndexOf('STEP=verify-current-production' + "`n", $protocolStart)
if ($protocolStart -lt 0 -or $protocolEnd -lt 0) { throw 'Could not extract verify-release-protocol for local execution' }
$protocolBlock = $RemoteForExtract.Substring($protocolStart, $protocolEnd - $protocolStart)
$ProtocolHarness = @'
#!/usr/bin/env bash
set -Eeuo pipefail
export PATH="/usr/bin:/mingw64/bin"
docker() { bash '__DOCKER_SHIM_FILE__' "$@"; }
RELEASE=$1
ROLLBACK=$2
SYNC_BASE=@@SYNC_BASE@@
if command -v node >/dev/null 2>&1; then
  printf 'HOST_NODE_UNEXPECTEDLY_AVAILABLE=%s\n' "$(command -v node)" >&2
  exit 90
fi
'@
$DockerShimBody = @'
#!/usr/bin/env bash
set -Eeuo pipefail
[[ "$#" -ge 13 && "$1" == run && "$2" == --rm && "$3" == --network && "$4" == none \
  && "$5" == --read-only && "$6" == -v && "$8" == -w && "$9" == /release \
  && "${10}" == 2jfitness-api:latest && "${11}" == node ]] || {
  printf 'DOCKER_SHIM_UNEXPECTED_ARGS=%s\n' "$*" >&2
  exit 91
}
[[ "$7" == *:/release:ro ]] || { printf 'DOCKER_SHIM_MOUNT_NOT_READONLY=%s\n' "$7" >&2; exit 92; }
mount="$(cygpath -m "${7%:/release:ro}"):/release:ro"
shift 11
MSYS_NO_PATHCONV=1 '__DOCKER_EXE__' run --rm --network none --read-only -v "$mount" -w /release '__LOCAL_API_IMAGE__' node "$@"
'@
$DockerShimUnix = ConvertTo-GitBashPath $DockerShimDirectory
$DockerShimFileUnix = ConvertTo-GitBashPath $DockerShim
$DockerShimBody = $DockerShimBody.Replace('__DOCKER_EXE__', (ConvertTo-GitBashPath (Get-Command docker.exe -ErrorAction Stop).Source)).Replace('__LOCAL_API_IMAGE__', $ApiImageTag)
$ProtocolHarness = $ProtocolHarness.Replace('__DOCKER_SHIM_FILE__', $DockerShimFileUnix)
New-Item -ItemType Directory -Force -Path $DockerShimDirectory | Out-Null
[System.IO.File]::WriteAllText($DockerShim, ($DockerShimBody -replace "`r`n", "`n"), $Utf8NoBom)
$ProtocolHarness += "`n" + $protocolBlock
[System.IO.File]::WriteAllText($ProtocolCheckRunner, ($ProtocolHarness -replace "`r`n", "`n"), $Utf8NoBom)
$ProtocolCheckRunnerUnix = ConvertTo-GitBashPath $ProtocolCheckRunner
$ReleaseUnix = ConvertTo-GitBashPath $Release
$RollbackUnix = ConvertTo-GitBashPath $RollbackRelease
& $Bash --noprofile --norc $ProtocolCheckRunnerUnix $ReleaseUnix $RollbackUnix
if ($LASTEXITCODE -ne 0) { throw 'LOCAL_VERIFY_RELEASE_PROTOCOL_FAILED; no production connection was made' }
Write-Host 'LOCAL_VERIFY_RELEASE_PROTOCOL=OK'


# Extract the exact read-only API runtime probe from the remote runner. The simulation runs it
# against both the extracted target tar and the installed simulated release with synthetic data.
$probeToken = '  cat > "$1" <<''JS''' + "`n"
$probeTokenStart = $RemoteForExtract.IndexOf($probeToken)
if ($probeTokenStart -lt 0) { throw 'Could not extract the runner API runtime probe' }
$probeBodyStart = $probeTokenStart + $probeToken.Length
$probeBodyEnd = $RemoteForExtract.IndexOf("`nJS`n}", $probeBodyStart)
if ($probeBodyEnd -lt 0) { throw 'Could not locate the end of the runner API runtime probe' }
$probeCode = $RemoteForExtract.Substring($probeBodyStart, $probeBodyEnd - $probeBodyStart)
[System.IO.File]::WriteAllText($RuntimeProbe, $probeCode, $Utf8NoBom)
$mutableFunctionStart = $RemoteForExtract.IndexOf('write_mutable_data_probe() {' + "`n")
if ($mutableFunctionStart -lt 0) { throw 'Could not locate the mutable data probe function' }
$mutableTokenStart = $RemoteForExtract.IndexOf($probeToken, $mutableFunctionStart)
if ($mutableTokenStart -lt 0) { throw 'Could not extract the mutable data probe' }
$mutableBodyStart = $mutableTokenStart + $probeToken.Length
$mutableBodyEnd = $RemoteForExtract.IndexOf("`nJS`n}", $mutableBodyStart)
if ($mutableBodyEnd -lt 0) { throw 'Could not locate the end of the mutable data probe' }
$mutableCode = $RemoteForExtract.Substring($mutableBodyStart, $mutableBodyEnd - $mutableBodyStart)
[System.IO.File]::WriteAllText($MutableProbe, $mutableCode, $Utf8NoBom)

$SimulationRunnerUnix = ConvertTo-GitBashPath $SimulationRunner
$RuntimeProbeUnix = ConvertTo-GitBashPath $RuntimeProbe
$MutableProbeUnix = ConvertTo-GitBashPath $MutableProbe
$rollbackHashArg = $RollbackHash.ToLowerInvariant()
$releaseHashArg = $LocalHash.ToLowerInvariant()
& $Bash --noprofile --norc $SimulationRunnerUnix $RollbackUnix $ReleaseUnix $RollbackCommit $Commit $rollbackHashArg $releaseHashArg $RuntimeProbeUnix $MutableProbeUnix
if ($LASTEXITCODE -ne 0) { throw 'LOCAL_TAR_ROLLBACK_SIMULATION_FAILED; production was not touched' }
Write-Host 'LOCAL_TAR_ROLLBACK_SIMULATION=OK'

if ($PrepareOnly) {
  Write-Host "LOCAL_RUNNER=$LocalRunner"
  Write-Host "PREPARE_ONLY_OK=$Commit (no scp, no ssh: production untouched)"
  Write-Host 'SIMULATION_ONLY=final summary exercised; no deployment was performed'
  Write-Host "DEPLOY_SCRIPT_OK=$Commit"
  return
}

Assert-2JAuthorized -AuthorizedBy $AuthorizedBy -Commit $Commit
Write-Host '2J_DEPLOY_CHANNEL=2j-prod (dedicated restricted key, no password)'
Test-2JChannel
Send-2JFile $Release
Send-2JFile $RollbackRelease
Send-2JFile $LocalRunner
$RunCode = Invoke-2JRun -Short $ShortCommit -RollbackShort $RollbackShort -RunId $RunId
if ($RunCode -ne 0) {
  throw "Remote deployment ended with code $RunCode. Check ORIGINAL_FAIL_STEP and ROLLBACK in the output."
}

Write-Host ''
Write-Host "DEPLOY_SCRIPT_OK=$Commit"

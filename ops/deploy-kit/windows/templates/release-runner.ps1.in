(cd "$RELEASE_CHECK_DIR" && find . -mindepth 1 ! -type d -printf '%P\n' | sort) > "$TARGET_PATHS"
(cd "$BASELINE_CHECK_DIR" && find . -mindepth 1 ! -type d -printf '%P\n' | sort) > "$BASELINE_PATHS"
: > "$DELTA_PATHS"
comm -23 "$TARGET_PATHS" "$BASELINE_PATHS" >> "$DELTA_PATHS"

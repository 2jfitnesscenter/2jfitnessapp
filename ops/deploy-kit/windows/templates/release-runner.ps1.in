# @@RELEASE_TITLE@@
#   .\deploy-@@TARGET_SHORT@@.ps1                 full run: local validation, archives, restricted channel + remote deploy
#   .\deploy-@@TARGET_SHORT@@.ps1 -PrepareOnly    local validation + archives + simulation (no production connection)
param([switch]$PrepareOnly, [string]$AuthorizedBy = '')
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
Set-Location -LiteralPath $PSScriptRoot

# ---- 2J restricted deploy channel (ops/deploy-kit) ----
# 2J Fitness deploy kit — transport + authorization functions, INLINED into every converted runner by convert-runner.mjs
# (so a runner stays one self-contained file, whichever branch is checked out). Uses only the `2j-prod` ssh alias: the dedicated
# restricted key, strict pinned host key, BatchMode (never prompts, never falls back to a password).

# The runner refuses to touch production unless the person typed the authorization phrase. This is a guard-rail for the
# agent workflow (an agent must pass back exactly what the owner wrote in chat); it is not a security boundary against the owner's own PC.
function Assert-2JAuthorized {
  param([string]$AuthorizedBy, [string]$Commit)
  if ($AuthorizedBy -cne 'AUTORIZO DEPLOY') {
    throw "NOT AUTHORIZED: a real deployment needs the owner's exact phrase. Re-run with -AuthorizedBy 'AUTORIZO DEPLOY' ONLY after the owner wrote it in chat for commit $Commit."
  }
  $dir = Join-Path $HOME '.2jfitness-deploy'
  New-Item -ItemType Directory -Force -Path $dir | Out-Null
  Add-Content -LiteralPath (Join-Path $dir 'audit.log') -Value ("{0} AUTHORIZED commit={1} user={2}" -f (Get-Date -Format o), $Commit, $env:USERNAME)
}

function Invoke-2JSsh {
  param([string[]]$Arguments)
  & ssh -o BatchMode=yes 2j-prod @Arguments
  return $LASTEXITCODE
}

# Harmless probe: key login works and the server-side forced command answers (no shell, no root).
function Test-2JChannel {
  $out = & ssh -o BatchMode=yes 2j-prod ping 2>&1 | Out-String
  if ($LASTEXITCODE -ne 0 -or $out -notmatch 'gate=ok user=deploy2j') {
    throw "Deploy channel not ready (run ops/deploy-kit/windows/verify-2j-deploy.ps1). Production was not changed. $out"
  }
  Write-Host ("2J_CHANNEL_OK " + $out.Trim())
}

# Streams one file over the restricted channel (binary-safe through cmd redirection; the server checks the name, size and re-hashes).
function Send-2JFile {
  param([string]$Path)
  if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { throw "Missing file to upload: $Path" }
  $name = Split-Path -Leaf $Path
  $out = & cmd.exe /d /c "ssh -o BatchMode=yes 2j-prod put $name < `"$Path`"" 2>&1 | Out-String
  if ($LASTEXITCODE -ne 0 -or $out -notmatch ('put=ok name=' + [regex]::Escape($name))) {
    throw "Upload failed for $name (exit $LASTEXITCODE). Production was not changed. $out"
  }
  $local = (Get-FileHash -Algorithm SHA256 -LiteralPath $Path).Hash.ToLowerInvariant()
  if ($out -notmatch ('sha256=' + $local)) { throw "Upload hash mismatch for $name. Production was not changed. Remote said: $out" }
  Write-Host ("UPLOADED $name sha256=$local")
}

# Hands over to the root wrapper through sudo: the existing remote runner (backup, checks, install, probes, data validation, rollback) does everything.
function Invoke-2JRun {
  param([string]$Short, [string]$RollbackShort, [string]$RunId)
  # Stream the remote output to the console only: anything left in the pipeline would be returned with the exit code
  # and make the caller treat a successful deployment as failed.
  & ssh -o BatchMode=yes 2j-prod run $Short $RollbackShort $RunId | Out-Host
  $code = $LASTEXITCODE
  return [int]$code
}
# ---- end channel ----

# The API suite exercises the backup/restore/secret scripts and needs bash + openssl. Put Git for Windows' on THIS run's PATH (ahead of System32's WSL bash.exe;
# tar stays the system one). The configured API pass/skip counts below are exact release gates.
$GitForTests = Split-Path (Split-Path (Get-Command git.exe -ErrorAction Stop).Source -Parent) -Parent
foreach ($p in @((Join-Path $GitForTests 'mingw64\bin'), (Join-Path $GitForTests 'bin'))) { if (Test-Path -LiteralPath $p) { $env:PATH = "$p;$env:PATH" } }

$Commit = '@@TARGET_COMMIT@@'
$ShortCommit = $Commit.Substring(0, 7)
$ExpectedCurrentCommit = '@@EXPECTED_CURRENT_COMMIT@@'
$ExpectedCurrentShort = $ExpectedCurrentCommit.Substring(0, 7)
$RollbackCommit = '@@ROLLBACK_COMMIT@@'
$RollbackShort = $RollbackCommit.Substring(0, 7)
if ($Commit -cnotmatch '^[0-9a-f]{40}$') { throw 'TARGET_COMMIT_MUST_BE_FULL_LOWERCASE_SHA40' }
if ($ExpectedCurrentCommit -cnotmatch '^[0-9a-f]{40}$') { throw 'EXPECTED_CURRENT_COMMIT_MUST_BE_FULL_LOWERCASE_SHA40' }
if ($RollbackCommit -cnotmatch '^[0-9a-f]{40}$') { throw 'ROLLBACK_COMMIT_MUST_BE_FULL_LOWERCASE_SHA40' }
if ($RollbackCommit -cne $ExpectedCurrentCommit) { throw 'ROLLBACK_MUST_EQUAL_EXPECTED_CURRENT' }
if (-not $RollbackCommit.StartsWith($RollbackShort, [StringComparison]::Ordinal)) { throw 'ROLLBACK_SHORT_SHA_DOES_NOT_MATCH_FULL_SHA' }
if (-not $Commit.StartsWith($ShortCommit, [StringComparison]::Ordinal)) { throw 'TARGET_SHORT_SHA_DOES_NOT_MATCH_FULL_SHA' }
if (-not $ExpectedCurrentCommit.StartsWith($ExpectedCurrentShort, [StringComparison]::Ordinal)) { throw 'ROLLBACK_SHORT_SHA_DOES_NOT_MATCH_FULL_SHA' }
$ExpectedFrontendTests = @@FRONTEND_TESTS@@
$ExpectedApiTests = @@API_TESTS@@
$ExpectedApiPassed = @@API_PASSED@@
$ExpectedApiSkipped = @@API_SKIPPED@@
$MaxCommitsForThisRelease = @@MAX_COMMITS@@
$SyncBase = '@@SYNC_BASE@@'
$Server = 'root@213.136.77.197'
$RunId = [guid]::NewGuid().ToString('N')
$Release = Join-Path $env:TEMP "2jfitness-code-$ShortCommit-$RunId.tar.gz"
$RollbackRelease = Join-Path $env:TEMP "2jfitness-code-$ShortCommit-rollback-$ExpectedCurrentShort-$RunId.tar.gz"
$RemoteRelease = "/root/backups/2jfitness-code-$ShortCommit-$RunId.tar.gz"
$RemoteRollback = "/root/backups/2jfitness-code-$ShortCommit-rollback-$ExpectedCurrentShort-$RunId.tar.gz"
$RemoteRunner = "/root/backups/deploy-$ShortCommit-$RunId.sh"
$LocalRunner = Join-Path $env:TEMP "deploy-$ShortCommit-$RunId.sh"
$SimulationRunner = Join-Path $env:TEMP "simulate-deploy-$ShortCommit-$RunId.sh"
$ProtocolCheckRunner = Join-Path $env:TEMP "verify-release-protocol-$ShortCommit-$RunId.sh"
$DockerShimDirectory = Join-Path $env:TEMP "verify-release-protocol-docker-shim-$ShortCommit-$RunId"
$DockerShim = Join-Path $DockerShimDirectory 'docker'
$RuntimeProbe = Join-Path $env:TEMP "gym-profile-runtime-probe-$ShortCommit-$RunId.mjs"
$MutableProbe = Join-Path $env:TEMP "community-data-probe-$ShortCommit-$RunId.mjs"

Write-Host "Preparando el release exacto $Commit..."
$Head = (git rev-parse HEAD).Trim()
if ($LASTEXITCODE -ne 0) { throw 'No se pudo leer HEAD' }
if ($Head -ne $Commit) {
  git merge-base --is-ancestor $Commit $Head
  if ($LASTEXITCODE -ne 0) { throw "El target $Commit no es HEAD ni ancestro del commit tooling actual $Head" }
  $LaterPaths = @(git diff-tree --no-commit-id --name-only -r $Commit $Head | Sort-Object -Unique)
  if ($LASTEXITCODE -ne 0) { throw 'No se pudo verificar el delta posterior de tooling' }
  $UnexpectedLaterPaths = @($LaterPaths | Where-Object { $_ -notin @('AI_HANDOFF.md', 'CHANGELOG.md', '.gitattributes', 'docs/GENERATED_FILES.md') -and $_ -notlike 'ops/deploy-kit/*' })
  if ($UnexpectedLaterPaths.Count -gt 0) { throw "El commit posterior incluye cambios ajenos al tooling: $($UnexpectedLaterPaths -join ', ')" }
  Write-Host "TARGET_ANCESTOR_TOOLING_ONLY=OK target=$Commit head=$Head"
}
git merge-base --is-ancestor $ExpectedCurrentCommit $Commit
if ($LASTEXITCODE -ne 0) { throw "PRODUCTION_NOT_ANCESTOR_OF_TARGET=$ExpectedCurrentCommit" }
$Commits = @(git rev-list --reverse "$ExpectedCurrentCommit..$Commit")
if ($Commits.Count -lt 1 -or $Commits.Count -gt $MaxCommitsForThisRelease) { throw "UNEXPECTED_COMMIT_COUNT=$($Commits.Count)" }
Write-Host "TARGET_COMMITS=$($Commits.Count) over production (delta is checked file by file below)"
$DeltaPaths = @(git diff-tree --no-commit-id --name-only -r $ExpectedCurrentCommit $Commit | Sort-Object -Unique)
$ExpectedDeltaPaths = @(@@DELTA_PATHS_PS@@)
if ($LASTEXITCODE -ne 0 -or (Compare-Object $ExpectedDeltaPaths $DeltaPaths)) { throw "UNEXPECTED_TARGET_DELTA=$($DeltaPaths -join ',')" }
Write-Host 'TARGET_DELTA=OK @@DELTA_COUNT@@ files (delta from verified production @@EXPECTED_CURRENT_SHORT@@)'
git diff --quiet --exit-code
if ($LASTEXITCODE -ne 0) { throw 'Hay cambios tracked sin commit en el working tree' }
git diff --cached --quiet --exit-code
if ($LASTEXITCODE -ne 0) { throw 'Hay cambios staged sin commit en el working tree' }

# The tree must be clean except the untracked deploy-*.ps1 runners (never committed).
function Assert-CleanTree([string]$When) {
  $lines = @(git status --porcelain --untracked-files=all)
  if ($LASTEXITCODE -ne 0) { throw 'git status failed' }
  $dirty = @($lines | Where-Object { $_ -and $_ -notmatch '^\?\? (GEMINI|HYDRA)\.md$|^\?\? deploy-[0-9a-f]+(\.2j)?\.ps1$|^\?\? verify-prod-7ebb722\.ps1$|^\?\? ops/deploy-kit/' })
  if ($dirty.Count -gt 0) { throw "El arbol no esta limpio ($When): $($dirty -join '; ')" }
  Write-Host "LOCAL_TREE_CLEAN=$When"
}
Assert-CleanTree 'antes-de-validar'
git merge-base --is-ancestor c4e005a260e34d5ab60123f6d2c187d1e4cdd3a3 $Commit
if ($LASTEXITCODE -ne 0) { throw 'AI_ANCESTOR_MISSING=c4e005a260e34d5ab60123f6d2c187d1e4cdd3a3' }
git merge-base --is-ancestor 946abddf383cd1e7d53a123a81183dfb07337223 $Commit
if ($LASTEXITCODE -ne 0) { throw 'AI_ANCESTOR_MISSING=946abddf383cd1e7d53a123a81183dfb07337223' }
git merge-base --is-ancestor 7563be5cae5ae4c4b10212817d9579ee87506720 $Commit
if ($LASTEXITCODE -ne 0) { throw 'AI_ANCESTOR_MISSING=7563be5cae5ae4c4b10212817d9579ee87506720' }
git merge-base --is-ancestor d87ec1823ea07ef43de3ea7b166cce3a89487c4a $Commit
if ($LASTEXITCODE -ne 0) { throw 'AI_ANCESTOR_MISSING=d87ec1823ea07ef43de3ea7b166cce3a89487c4a' }
git merge-base --is-ancestor 25b3dda688ce2094523de23101daf0255e215178 $Commit
if ($LASTEXITCODE -ne 0) { throw 'AI_ANCESTOR_MISSING=25b3dda688ce2094523de23101daf0255e215178' }
Write-Host 'AI_CHANGES_INCLUDED=YES c4e005a 946abdd 7563be5 d87ec18 25b3dda'

# Local validation: every command must pass, with the exact test counts of this HEAD. Output goes
# to a log per step (cmd redirection, so native stderr never trips PowerShell's Stop policy).
$ValidationDir = Join-Path $env:TEMP "2jfitness-validate-$ShortCommit-$RunId"
New-Item -ItemType Directory -Force -Path $ValidationDir | Out-Null
function Invoke-Checked([string]$Name, [string]$Dir, [string]$CommandLine, [string[]]$MustMatch = @()) {
  $log = Join-Path $ValidationDir "$Name.log"
  Push-Location -LiteralPath $Dir
  try {
    & cmd.exe /d /c "$CommandLine > `"$log`" 2>&1"
    $code = $LASTEXITCODE
  } finally { Pop-Location }
  $text = ''
  if (Test-Path -LiteralPath $log) { $text = [System.IO.File]::ReadAllText($log) -replace '\x1b\[[0-9;]*m', '' }
  if ($code -ne 0) {
    Write-Host (($text -split "`n" | Select-Object -Last 40) -join "`n")
    throw "LOCAL_$Name FAILED (exit $code). Log: $log"
  }
  foreach ($re in $MustMatch) {
    if ($text -notmatch $re) {
      Write-Host (($text -split "`n" | Select-Object -Last 40) -join "`n")
      throw "LOCAL_$Name FAILED: output does not match '$re'. Log: $log"
    }
  }
  Write-Host "LOCAL_$Name=OK"
}
function Invoke-FrontendTests {
  $policy = Join-Path $Root 'ops/deploy-kit/windows/frontend-test-policy.mjs'
  if (-not (Test-Path -LiteralPath $policy -PathType Leaf)) { throw 'FRONTEND_TEST_POLICY_MISSING' }
  $normalLog = Join-Path $ValidationDir 'FRONTEND_TESTS.log'
  $normalJson = Join-Path $ValidationDir 'FRONTEND_TESTS.json'
  $normalDecisionLog = Join-Path $ValidationDir 'FRONTEND_TESTS_POLICY.log'
  Push-Location -LiteralPath $Frontend
  try {
    & cmd.exe /d /c "npx vitest run --reporter=json --outputFile=`"$normalJson`" > `"$normalLog`" 2>&1"
    $normalCode = $LASTEXITCODE
  } finally { Pop-Location }
  & cmd.exe /d /c "node `"$policy`" initial `"$normalJson`" $ExpectedFrontendTests $normalCode > `"$normalDecisionLog`" 2>&1"
  $normalDecisionCode = $LASTEXITCODE
  $normalDecision = if (Test-Path -LiteralPath $normalDecisionLog) { [System.IO.File]::ReadAllText($normalDecisionLog).Trim() } else { '' }
  if ($normalCode -eq 0 -and $normalDecisionCode -eq 0 -and $normalDecision.StartsWith('VITEST_POLICY=PASS ', [StringComparison]::Ordinal)) {
    Write-Host 'LOCAL_FRONTEND_TESTS=OK'
    return
  }
  if ($normalCode -ne 0 -and $normalDecisionCode -eq 2 -and $normalDecision.StartsWith('VITEST_POLICY=TIMEOUT_ONLY ', [StringComparison]::Ordinal)) {
    $initialFailed = 0
    if ($normalDecision -match '"failed":(\d+)') { $initialFailed = [int]$Matches[1] }
    $retryLog = Join-Path $ValidationDir 'FRONTEND_TESTS_RETRY.log'
    $retryJson = Join-Path $ValidationDir 'FRONTEND_TESTS_RETRY.json'
    $retryDecisionLog = Join-Path $ValidationDir 'FRONTEND_TESTS_RETRY_POLICY.log'
    Push-Location -LiteralPath $Frontend
    try {
      & cmd.exe /d /c "npx vitest run --maxWorkers=1 --minWorkers=1 --reporter=json --outputFile=`"$retryJson`" > `"$retryLog`" 2>&1"
      $retryCode = $LASTEXITCODE
    } finally { Pop-Location }
    & cmd.exe /d /c "node `"$policy`" retry `"$retryJson`" $ExpectedFrontendTests $retryCode > `"$retryDecisionLog`" 2>&1"
    $retryDecisionCode = $LASTEXITCODE
    $retryDecision = if (Test-Path -LiteralPath $retryDecisionLog) { [System.IO.File]::ReadAllText($retryDecisionLog).Trim() } else { '' }
    if ($retryCode -eq 0 -and $retryDecisionCode -eq 0 -and $retryDecision.StartsWith('VITEST_POLICY=PASS ', [StringComparison]::Ordinal)) {
      Write-Host "LOCAL_FRONTEND_TESTS_RETRY=PASS reason=timeout-only initial_failed=$initialFailed final=$ExpectedFrontendTests/$ExpectedFrontendTests"
      return
    }
    if (Test-Path -LiteralPath $retryLog) { Write-Host (([System.IO.File]::ReadAllText($retryLog) -split "`n" | Select-Object -Last 40) -join "`n") }
    throw "LOCAL_FRONTEND_TESTS FAILED: single-worker retry was not a complete pass ($retryDecision). Log: $retryLog"
  }
  if (Test-Path -LiteralPath $normalLog) { Write-Host (([System.IO.File]::ReadAllText($normalLog) -split "`n" | Select-Object -Last 40) -join "`n") }
  throw "LOCAL_FRONTEND_TESTS FAILED: initial run was not a complete pass or timeout-only report ($normalDecision). Log: $normalLog"
}
$Root = (Get-Location).Path
$Frontend = Join-Path $Root 'frontend'
$Api = Join-Path $Root 'api'

# Target-image check for the Community modules: the API image must contain and import the
# server.js dependencies, then its own /api/health must return 200 before any release is prepared.
$ApiImageTag = "2jfitness-api:$ShortCommit-runner-check"
Write-Host "Validating target API image $ApiImageTag..."
# BuildKit writes its normal progress to stderr; with ErrorActionPreference=Stop Windows PowerShell turns that into a NativeCommandError.
# Keep the output visible (and in the transcript/log), and use docker.exe's real exit code as the only criterion.
$PreviousEap = $ErrorActionPreference
$ErrorActionPreference = 'Continue'
try { & docker build --file (Join-Path $Api 'Dockerfile') --tag $ApiImageTag $Api 2>&1 | ForEach-Object { "$_" } | Out-Host }
finally { $ErrorActionPreference = $PreviousEap }
$DockerBuildExit = $LASTEXITCODE
Write-Host "DOCKER_BUILD_EXIT=$DockerBuildExit"
if ($DockerBuildExit -ne 0) { throw 'TARGET_API_IMAGE_BUILD_FAILED' }
$ModuleCheck = @'
import fs from 'node:fs';
for (const path of ['/app/notifications/routes.js', '/app/social/sharing-routes.js', '/app/lib/guided-store.js', '/app/lib/library-admin.js', '/app/lib/library-admin-routes.js', '/app/lib/library-overlay.js', '/app/lib/guided-programs-official.json', '/app/coach/ai-run.js', '/app/coach/intelligence.js', '/app/lib/guided-program-model.js', '/app/bunker/routes.js', '/app/lib/workout-activity.js']) {
  if (!fs.existsSync(path)) throw new Error(`Missing image module: ${path}`);
}
await import('file:///app/notifications/routes.js');
await import('file:///app/social/sharing-routes.js');
await import('file:///app/lib/guided-store.js');
await import('file:///app/lib/library-admin.js');
await import('file:///app/lib/library-admin-routes.js');
await import('file:///app/lib/news-store.js');
await import('file:///app/lib/news-routes.js');
const fe = await import('file:///app/lib/features-store.js');
await import('file:///app/lib/features-routes.js');
if (fe.FEATURE_KEYS.length !== 15) throw new Error('features module wrong');
const wo = await import('file:///app/lib/webauthn-origins.js');
if (wo.expectedOrigins('https://x.test', '').length !== 3 || !wo.expectedOrigins('https://x.test', '').includes('android:apk-key-hash:Xtnl80w2A-0scA3f4Jtf5D5UvAZ0dgJ7RTpZsbqv3tE')) throw new Error('webauthn origins module wrong');
const ai = await import('file:///app/coach/ai-run.js');
const intelligence = await import('file:///app/coach/intelligence.js');
const jobs = await import('file:///app/coach/jobs.js');
await import('file:///app/coach/trainer-jobs.js');
if (typeof ai.invokeWithRetry !== 'function' || typeof ai.classify !== 'function' || typeof jobs.claimExplanation !== 'function' || typeof intelligence.explainSignal !== 'function') throw new Error('Coach Intelligence exports missing');
await import('file:///app/lib/guided-program-model.js');
await import('file:///app/bunker/routes.js');
const activity = await import('file:///app/lib/workout-activity.js');
if (activity.WORKOUT_INACTIVITY_MS !== 3600000 || typeof activity.buildFinishedWorkout !== 'function') throw new Error('Inactivity module missing');
const source = fs.readFileSync('/app/server.js', 'utf8');
for (const match of source.matchAll(/(?:from\s*|import\s*)['"](\.\/[^'"]+)['"]/g)) {
  if (!fs.existsSync('/app/' + match[1])) throw new Error('Missing server import: ' + match[1]);
}
console.log('TARGET_IMAGE_IMPORTS=OK');
'@
$ModuleCheck | & docker run -i --rm --network none --read-only --entrypoint node $ApiImageTag --input-type=module -
if ($LASTEXITCODE -ne 0) { throw 'TARGET_API_IMAGE_MODULE_CHECK_FAILED' }
Write-Host 'TARGET_API_IMAGE_FILES=OK community guided library-admin coach/ai-run.js coach/intelligence.js'
$ImageSmokeName = "2j-api-image-smoke-$RunId"
$ImageSmokeData = "/tmp/2j-api-image-smoke-$RunId"
& docker run --detach --name $ImageSmokeName --network none --env PORT=3000 --env "DATA_DIR=$ImageSmokeData" $ApiImageTag
if ($LASTEXITCODE -ne 0) { throw 'TARGET_API_IMAGE_START_FAILED' }
try {
  $HealthScript = 'try { const r=await fetch("http://127.0.0.1:3000/api/health"); const b=await r.json(); console.log(`HTTP=${r.status} BODY=${JSON.stringify(b)}`); if(r.status!==200 || b.ok!==true) process.exit(1); } catch { process.exit(2); }'
  $ImageHealthy = $false
  $ImageHealthOutput = ''
  $ImageDeadline = (Get-Date).AddSeconds(30)
  do {
    $ImageHealthOutput = ($HealthScript | & docker exec -i $ImageSmokeName node --input-type=module - 2>$null | Out-String).Trim()
    if ($LASTEXITCODE -eq 0 -and $ImageHealthOutput -match '^HTTP=200 BODY=') { $ImageHealthy = $true; break }
    Start-Sleep -Seconds 1
  } while ((Get-Date) -lt $ImageDeadline)
  if (-not $ImageHealthy) { & docker logs $ImageSmokeName; throw "TARGET_API_IMAGE_HEALTH_FAILED $ImageHealthOutput" }
  Write-Host "TARGET_API_IMAGE_HEALTH=OK $ImageHealthOutput"
} finally {
  & docker rm --force $ImageSmokeName | Out-Null
}
Write-Host 'Validacion local (tests, build, locales, generadores)...'
Invoke-Checked 'DEPLOY_TOOLING_TESTS' $Root 'node --test ops/deploy-kit/windows/generate-release-runner.test.mjs ops/deploy-kit/windows/frontend-test-policy.test.mjs' @('tests 18', 'pass 18', 'fail 0', 'skipped 0')
Invoke-FrontendTests
Invoke-Checked 'EXPERIENCE_V2_TESTS' $Frontend 'npx vitest run src/views/v2.test.jsx src/views/health-v2.test.jsx src/views/social-v2.test.jsx' @('Tests\s+61 passed \(61\)')
Invoke-Checked 'API_TESTS' $Api 'npm test' @("\btests $ExpectedApiTests\b", "\bpass $ExpectedApiPassed\b", '\bfail 0\b', '\bcancelled 0\b', "\bskipped $ExpectedApiSkipped\b")
Invoke-Checked 'SHARED_STAFF_AUTH_TESTS' $Api 'node --test test/shared-staff.test.js test/auth-rate-limit.test.js test/roles.test.js test/webauthn-origins.test.js test/bunker-revocation.test.js test/sync.test.js' @('tests 39', 'pass 39', 'fail 0', 'skipped 0')
Invoke-Checked 'BUILD' $Frontend 'npm run build' @('built in')
$Dist = Join-Path $Frontend 'dist'
$BuiltIndex = Join-Path $Dist 'index.html'
if (-not (Test-Path -LiteralPath $BuiltIndex -PathType Leaf)) { throw 'LOCAL_SMOKE: frontend dist/index.html missing' }
$BuiltHtml = [System.IO.File]::ReadAllText($BuiltIndex)
$BuiltAssets = [regex]::Matches($BuiltHtml, '/assets/index-[A-Za-z0-9_-]+\.(?:js|css)') | ForEach-Object { $_.Value } | Sort-Object -Unique
if (@($BuiltAssets | Where-Object { $_ -match '\.js$' }).Count -ne 1 -or @($BuiltAssets | Where-Object { $_ -match '\.css$' }).Count -ne 1) { throw 'LOCAL_SMOKE: built index must reference one main JS and CSS asset' }
foreach ($asset in $BuiltAssets) {
  $assetPath = Join-Path $Dist ($asset.TrimStart('/').Replace('/', '\'))
  if (-not (Test-Path -LiteralPath $assetPath -PathType Leaf) -or (Get-Item -LiteralPath $assetPath).Length -le 0) { throw "LOCAL_SMOKE: built asset missing or empty: $asset" }
}
$BuiltJsAsset = [string]($BuiltAssets | Where-Object { $_ -match '\.js$' } | Select-Object -First 1)
$BuiltCssAsset = [string]($BuiltAssets | Where-Object { $_ -match '\.css$' } | Select-Object -First 1)
$BuiltJs = Join-Path $Dist ($BuiltJsAsset.TrimStart([char]'/').Replace('/', '\'))
$BuiltCss = Join-Path $Dist ($BuiltCssAsset.TrimStart([char]'/').Replace('/', '\'))
$BuiltJsText = [System.IO.File]::ReadAllText($BuiltJs)
$BuiltCssText = [System.IO.File]::ReadAllText($BuiltCss)
foreach ($marker in @('gym-profile-card', 'gym-equipment-chip', 'gym-row-info')) {
  if (-not $BuiltJsText.Contains($marker) -or -not $BuiltCssText.Contains($marker)) { throw "LOCAL_GYM_UI_ASSET_SMOKE: missing technical marker $marker" }
}
if (-not $BuiltJsText.Contains('gym-official-editor') -or -not $BuiltJsText.Contains('saveOfficialGymEquipment') -or -not $BuiltCssText.Contains('gym-official-group')) { throw 'LOCAL_GYM_V11_ASSET_SMOKE: admin editor markers missing' }Write-Host 'LOCAL_GYM_UI_ASSET_SMOKE=OK js_css=visual_picker+equipment+settings_info'
if (-not $BuiltCssText.Contains('news-track') -or -not $BuiltCssText.Contains('news-card')) { throw 'LOCAL_NEWS_ASSET_SMOKE: news styles missing from the built CSS' }
if (@(Get-ChildItem -LiteralPath (Join-Path $Dist 'assets') -Filter 'AdminNews-*.js' | Where-Object { $_.Length -gt 0 }).Count -ne 1) { throw 'LOCAL_NEWS_ASSET_SMOKE: AdminNews lazy chunk missing or duplicated' }
if (-not $BuiltCssText.Contains('ux-card') -or -not $BuiltCssText.Contains('set-grp') -or -not $BuiltCssText.Contains('ai-block')) { throw 'LOCAL_UX_ASSET_SMOKE: adaptive UX styles missing from the built CSS' }
foreach ($uxChunk in @('AdminFeatures', 'AdminAI')) { if (@(Get-ChildItem -LiteralPath (Join-Path $Dist 'assets') -Filter "$uxChunk-*.js" | Where-Object { $_.Length -gt 0 }).Count -ne 1) { throw "LOCAL_UX_ASSET_SMOKE: $uxChunk lazy chunk missing or duplicated" } }
foreach ($pwaPath in @('manifest.json', 'sw.js', 'icon-192.png', 'icon-512.png')) {
  $fullPwaPath = Join-Path $Dist $pwaPath
  if (-not (Test-Path -LiteralPath $fullPwaPath -PathType Leaf) -or (Get-Item -LiteralPath $fullPwaPath).Length -le 0) { throw "LOCAL_SMOKE: PWA asset missing or empty: $pwaPath" }
}
foreach ($chunk in @('StudioAdmin', 'ProgramEditor', 'LibraryQuality')) {
  $found = @(Get-ChildItem -LiteralPath (Join-Path $Dist 'assets') -Filter "$chunk-*.js" | Where-Object { $_.Length -gt 0 })
  if ($found.Count -ne 1) { throw "LOCAL_STUDIO_CHUNK_SMOKE: lazy chunk $chunk missing or duplicated" }
}
if (-not $BuiltJsText.Contains('StudioAdmin-') -or -not $BuiltJsText.Contains('LibraryQuality-')) { throw 'LOCAL_STUDIO_CHUNK_SMOKE: main bundle does not reference the lazy Studio chunks' }
Write-Host 'LOCAL_STUDIO_CHUNKS=OK StudioAdmin+ProgramEditor+LibraryQuality referenced by the main bundle'
Write-Host 'LOCAL_ASSET_SMOKE=OK main_js_css=nonempty pwa=manifest+sw+icons'
Invoke-Checked 'CHECK_LOCALES' $Frontend 'node scripts/check-locales.mjs' @('(?m)^es: (\d+)/\1 \(100%\)')
# 2J Training Protocol v1.0: the API runtime copy, the official block library (155 master blocks),
# the official guided routines (39 + 7 collections) and the AI index must be exactly what this
# HEAD generates. Nothing is written.
Invoke-Checked 'SYNC_PROTOCOL' $Root 'node scripts/sync-protocol.mjs --check' @('in sync \(9 files\)')
Invoke-Checked 'SYNC_GYM_PROFILES' $Root 'node scripts/sync-gym-profiles.mjs --check' @('Gym profile model in sync')
Invoke-Checked 'SYNC_LIBRARY_OVERLAY' $Root 'node scripts/sync-library-overlay.mjs --check' @('Library overlay rules in sync')
Invoke-Checked 'GUIDED_PROGRAM_MODEL' $Root 'node scripts/sync-guided-program-model.mjs --check' @('GUIDED_PROGRAM_MODEL=OK')
Invoke-Checked 'WORKOUT_ACTIVITY_MODEL' $Root 'node scripts/sync-workout-activity.mjs --check' @('WORKOUT_ACTIVITY_MODEL=OK')
Invoke-Checked 'STARTING_LOAD_TESTS' $Frontend 'npm test -- --run src/lib/starting-load.test.js src/lib/workout-activity.test.js' @('26 passed')
Invoke-Checked 'BUNKER_TESTS' $Frontend 'npm test -- --run src/lib/bunker-workout.test.js src/lib/bunker-persistence.test.js src/lib/bunker-credentials.test.js' @('24 passed')
Invoke-Checked 'OFFICIAL_BLOCKS' $Root 'node scripts/build-official-blocks.mjs --check' @('in sync: 198 blocks')
Invoke-Checked 'OFFICIAL_ROUTINES' $Root 'node scripts/build-official-routines.mjs --check' @('in sync: 155 routines, 15 collections')
Invoke-Checked 'COACH_LIBRARY' $Root 'node scripts/build-coach-library.mjs --check' @('in sync \(1324 exercises\)')
# Exercise Library V2: integrity (ids, taxonomy, deprecations, aliases, Recommended 2J) and the
# reproducible audit, with the exact metrics of this HEAD.
Invoke-Checked 'CHECK_EXERCISE_LIBRARY' $Root 'node scripts/check-exercise-library.mjs' @('Exercise library OK: 1324 exercises, 210 recommended, 26 deprecated, 1305 with a canonical movement\.')
Invoke-Checked 'AUDIT_EXERCISE_LIBRARY' $Root 'node scripts/audit-exercise-library.mjs --check' @('in sync \(1324 exercises, 0 possible-duplicate groups\)')
git diff --check
if ($LASTEXITCODE -ne 0) { throw 'git diff --check failed' }
Write-Host 'LOCAL_DIFF_CHECK=OK'
git diff --quiet --exit-code
if ($LASTEXITCODE -ne 0) { throw 'The local validation changed tracked files' }
Assert-CleanTree 'despues-de-validar'

if (Test-Path -LiteralPath $Release) { throw "Release artifact already exists; preserve it and choose a new temp path: $Release" }
git archive --format=tar.gz --output=$Release $Commit
if ($LASTEXITCODE -ne 0) { throw 'git archive failed' }
if (Test-Path -LiteralPath $RollbackRelease) { throw "Rollback artifact already exists; preserve it and choose a new temp path: $RollbackRelease" }
git archive --format=tar.gz --output=$RollbackRelease $RollbackCommit
if ($LASTEXITCODE -ne 0) { throw 'git archive for rollback failed' }

$Marker = tar -xOf $Release SYNC_V2_ROLLBACK_BASE
if ($LASTEXITCODE -ne 0 -or ($Marker -join "`n") -notmatch [regex]::Escape($SyncBase)) {
  throw 'El release no contiene el checkpoint Sync V2 compatible'
}
$LocalHash = (Get-FileHash -Algorithm SHA256 -LiteralPath $Release).Hash.ToLowerInvariant()
$RollbackMarker = tar -xOf $RollbackRelease SYNC_V2_ROLLBACK_BASE
if ($LASTEXITCODE -ne 0 -or ($RollbackMarker -join "`n") -notmatch [regex]::Escape($SyncBase)) {
  throw 'El rollback no contiene el checkpoint Sync V2 compatible'
}
$RollbackHash = (Get-FileHash -Algorithm SHA256 -LiteralPath $RollbackRelease).Hash.ToLowerInvariant()
$TamperRoot = Join-Path $env:TEMP "verify-tampered-rollback-$RunId"
$TamperedRollback = Join-Path $env:TEMP "2jfitness-code-tampered-rollback-$RunId.tar.gz"
New-Item -ItemType Directory -Force -Path $TamperRoot | Out-Null
& tar.exe -xzf $RollbackRelease -C $TamperRoot
if ($LASTEXITCODE -ne 0) { throw 'Could not prepare the negative rollback test' }
[IO.File]::AppendAllText((Join-Path $TamperRoot 'README.md'), "`nrunner-negative-test`n", [Text.Encoding]::UTF8)
& tar.exe -czf $TamperedRollback -C $TamperRoot .
if ($LASTEXITCODE -ne 0) { throw 'Could not repack the manipulated rollback test archive' }
$TamperedHash = (Get-FileHash -Algorithm SHA256 -LiteralPath $TamperedRollback).Hash.ToLowerInvariant()
if ($TamperedHash -eq $RollbackHash) { throw 'Negative rollback test failed: modified archive retained pinned SHA-256' }
Write-Host 'NEGATIVE_ROLLBACK_REJECTED=OK manipulated_archive_sha256_mismatch'
Remove-Item -LiteralPath $TamperRoot -Recurse -Force;Remove-Item -LiteralPath $TamperedRollback -Force
# The release never carries data/: production data is never overwritten by an archive.
$DataEntries = @(tar -tzf $Release | Where-Object { $_ -match '^data(/|$)|(^|/)(node_modules|coverage|\.cache|\.vite)(/|$)|^frontend/dist(/|$)|^\.env$|\.(pem|key)$' })
if ($LASTEXITCODE -ne 0) { throw 'tar -t failed on the release' }
if ($DataEntries.Count -gt 0) { throw "El release contiene data/: $($DataEntries -join ', ')" }
$SeriesFeedbackTarget = @(tar -tzf $Release | Where-Object { $_ -eq 'frontend/src/lib/set-feedback.js' })
$SeriesFeedbackRollback = @(tar -tzf $RollbackRelease | Where-Object { $_ -eq 'frontend/src/lib/set-feedback.js' })
if ($SeriesFeedbackTarget.Count -ne 1 -or $SeriesFeedbackRollback.Count -ne 1) { throw 'Series Feedback V1 debe estar presente en target y rollback' }
$GymFiles = @(tar -tzf $Release | Where-Object { $_ -in @('frontend/src/lib/gym-profile-model.js', 'frontend/src/lib/gym-profiles.js', 'api/lib/gym-profiles.js', 'scripts/sync-gym-profiles.mjs', 'api/test/gym-profiles.test.js') })
if ($GymFiles.Count -ne 5) { throw 'El release no contiene todos los archivos base de Gym Profiles V1' }
$RollbackGymModel = @(tar -tzf $RollbackRelease | Where-Object { $_ -eq 'frontend/src/lib/gym-profile-model.js' })
if ($GymFiles.Count -ne 5 -or $RollbackGymModel.Count -ne 1) { throw 'Gym Profiles V1 must remain in both target and rollback' }
Write-Host 'LOCAL_BASELINE=OK Sync V2 marker and Gym Profiles V1 present in target and rollback'
Write-Host "LOCAL_RELEASE=$Release"
Write-Host "LOCAL_SHA256=$LocalHash"
Write-Host "LOCAL_ROLLBACK=$RollbackRelease"
Write-Host "LOCAL_ROLLBACK_SHA256=$RollbackHash"

$RemoteScriptTemplate = @'
#!/usr/bin/env bash
set -Eeuo pipefail

APP=/opt/2jfitness
RELEASE=__REMOTE_RELEASE__
ROLLBACK=__REMOTE_ROLLBACK__
EXPECTED_HASH=__EXPECTED_HASH__
EXPECTED_ROLLBACK_HASH=__EXPECTED_ROLLBACK_HASH__
TARGET_COMMIT=__TARGET_COMMIT__
ROLLBACK_COMMIT=__ROLLBACK_COMMIT__
SYNC_BASE=@@SYNC_BASE@@
COMPOSE=(docker compose -f docker-compose.yml -f docker-compose.prod.yml)
STEP=bootstrap
DEPLOY_STARTED=0
STAMP=$(date +%F_%H%M%S)
LOG=/root/backups/deploy-@@TARGET_SHORT@@-$STAMP.log
READINESS_TIMEOUT_SEC=120
SMOKE_TIMEOUT_SEC=45
RETRY_INTERVAL_SEC=2
exec > >(tee -a "$LOG") 2>&1

header_value() {
  local file=$1 name=$2
  awk -v wanted="$name" '{key=$0; sub(/:.*/, "", key); if (tolower(key) == tolower(wanted)) {sub(/^[^:]*:[[:space:]]*/, ""); sub(/\r$/, ""); print; exit}}' "$file"
}

asset_bodies_ready() {
  local js_type css_type
  [[ -s /tmp/2j-asset-body && -s /tmp/2j-style-body ]] || return 1
  js_type=$(header_value /tmp/2j-asset-headers Content-Type)
  css_type=$(header_value /tmp/2j-style-headers Content-Type)
  case "$js_type" in application/javascript*|text/javascript*) ;; *) return 1 ;; esac
  case "$css_type" in text/css*) ;; *) return 1 ;; esac
  grep -Fq 'gym-profile-card' /tmp/2j-asset-body || return 1
  grep -Fq 'gym-equipment-chip' /tmp/2j-asset-body || return 1
  grep -Fq 'gym-row-info' /tmp/2j-asset-body || return 1
  grep -Fq 'gym-official-editor' /tmp/2j-asset-body || return 1
  grep -Fq 'saveOfficialGymEquipment' /tmp/2j-asset-body || return 1
  grep -Fq 'gym-profile-card' /tmp/2j-style-body || return 1
  grep -Fq 'gym-equipment-chip' /tmp/2j-style-body || return 1
  grep -Fq 'gym-row-info' /tmp/2j-style-body || return 1
  grep -Fq 'gym-official-group' /tmp/2j-style-body || return 1
}

http_probe() {
  local url=$1 body=$2 headers=$3 encoding=${4:-} method=${5:-GET} data=${6:-} max_time=${7:-10}
  local connect_time=4
  if (( max_time < connect_time )); then
    connect_time=$max_time
  fi
  local -a args=(--silent --show-error --connect-timeout "$connect_time" --max-time "$max_time" -D "$headers" -o "$body" --write-out '%{http_code}')
  : > "$headers"
  : > "$body"
  if [[ "$method" != GET ]]; then
    args+=(--request "$method")
  fi
  if [[ -n "$data" ]]; then
    args+=(-H 'Content-Type: application/json' --data "$data")
  fi
  if [[ -n "$encoding" ]]; then
    args+=(--compressed -H "Accept-Encoding: $encoding")
  fi
  curl "${args[@]}" "$url"
}

http_probe_for_retry() {
  # This function always runs inside wait_status' command-substitution
  # subshell. Keep the global ERR/rollback trap active everywhere else, but
  # never let curl's nonzero transport status escape this retry boundary.
  trap - ERR
  set +e
  local response transport
  response=$(http_probe "$@")
  transport=$?
  [[ -n "$response" ]] || response=000
  printf '%s %s' "$transport" "$response"
  return 0
}

wait_status() {
  local expected=$1 url=$2 body=$3 headers=$4 timeout=${5:-45} encoding=${6:-} method=${7:-GET} data=${8:-}
  local status=000 transport=0 probe_result deadline=$((SECONDS + timeout)) remaining attempt_time sleep_time attempt=0 transient
  while (( SECONDS < deadline )); do
    attempt=$((attempt + 1))
    remaining=$((deadline - SECONDS))
    attempt_time=$((remaining < 10 ? remaining : 10))
    if (( attempt_time < 1 )); then
      attempt_time=1
    fi
    probe_result=$(http_probe_for_retry "$url" "$body" "$headers" "$encoding" "$method" "$data" "$attempt_time")
    read -r transport status <<< "$probe_result"
    [[ -n "$status" ]] || status=000
    transient=0
    if (( transport == 0 )) && [[ "$status" == "$expected" ]]; then
      printf 'HTTP_OK attempt=%s url=%s status=%s\n' "$attempt" "$url" "$status" >&2
      printf '%s' "$status"
      return 0
    fi
    # Only startup/network failures that can recover by themselves are retried.
    # Keep all other transport errors and HTTP responses immediately fatal.
    if (( transport != 0 )); then
      case "$transport" in
        6|7|28|52|56) transient=1 ;;
        *)
          printf 'HTTP_FATAL url=%s expected=%s status=%s transport=%s reason=non-transient-transport\n' "$url" "$expected" "$status" "$transport" >&2
          printf '%s' "$status"
          return 1
          ;;
      esac
    elif [[ "$status" == 000 || "$status" == 502 || "$status" == 503 ]]; then
      transient=1
    else
      printf 'HTTP_FATAL url=%s expected=%s status=%s transport=0 reason=non-transient-http\n' "$url" "$expected" "$status" >&2
      printf '%s' "$status"
      return 1
    fi
    printf 'HTTP_RETRY attempt=%s url=%s expected=%s status=%s transport=%s remaining=%ss\n' "$attempt" "$url" "$expected" "$status" "$transport" "$((deadline - SECONDS))" >&2
    if (( SECONDS >= deadline )); then
      break
    fi
    remaining=$((deadline - SECONDS))
    sleep_time=$((remaining < RETRY_INTERVAL_SEC ? remaining : RETRY_INTERVAL_SEC))
    if (( sleep_time > 0 )); then
      sleep "$sleep_time"
    fi
  done
  printf 'HTTP_RETRY_EXHAUSTED url=%s expected=%s status=%s transport=%s timeout=%ss\n' "$url" "$expected" "$status" "$transport" "$timeout" >&2
  printf '%s' "$status"
  return 1
}

wait_services() {
  local timeout=${1:-45}
  local deadline=$((SECONDS + timeout)) running missing service remaining sleep_time api_id api_health
  while (( SECONDS < deadline )); do
    running=$("${COMPOSE[@]}" ps --status running --services 2>/dev/null || true)
    missing=''
    for service in api web caddy; do
      awk -v wanted="$service" '$0 == wanted {found=1} END {exit !found}' <<< "$running" || missing="$missing $service"
    done
    api_id=$("${COMPOSE[@]}" ps -q api 2>/dev/null || true)
    api_health=$(docker inspect --format '{{.State.Health.Status}}' "$api_id" 2>/dev/null || true)
    [[ "$api_health" == healthy ]] || missing="$missing api-health:$api_health"
    if [[ -z "$missing" ]]; then printf '%s' "$running"; return 0; fi
    printf 'SERVICE_RETRY missing=%s remaining=%ss\n' "$missing" "$((deadline - SECONDS))" >&2
    remaining=$((deadline - SECONDS))
    sleep_time=$((remaining < RETRY_INTERVAL_SEC ? remaining : RETRY_INTERVAL_SEC))
    if (( sleep_time > 0 )); then
      sleep "$sleep_time"
    fi
  done
  printf 'SERVICE_RETRY_EXHAUSTED timeout=%ss\n' "$timeout" >&2
  return 1
}

chown_archive_files() {
  local archive=$1
  while IFS= read -r rel; do
    [[ -z "$rel" || "$rel" == data || "$rel" == data/* ]] && continue
    [[ -e "$APP/$rel" || -L "$APP/$rel" ]] && chown -h 2jfitness:2jfitness "$APP/$rel"
  done < <(tar -tzf "$archive")
}

# Read-only check of the deployed 2J protocol inside the running api container: official master
# blocks (155, curated, no FAIL/unverified), the official guided routines (39 + 7 collections), the
# treadmill fix and the save policy on pure functions. It never calls a route, never writes /data
# (listFor only reads blocks.json / guided.json when they exist) and never creates anything.
write_protocol_probe() {
  cat > "$1" <<'JS'
const B = process.env.PROBE_BASE || 'file:///app/';
const fail = m => { console.log('PROBE_FAIL=' + m); process.exit(1); };
const fs = await import('node:fs');
const activity = await import(B + 'lib/workout-activity.js');
if (activity.WORKOUT_INACTIVITY_MS !== 3600000) fail('inactivity_timeout');
const clock = 36000000;
const draft = { id: 'synthetic-inactivity', start: clock, lastActivityAt: clock, d: '2026-10-01', entries: [] };
if (activity.workoutInactive(draft, clock + 3599999) || !activity.workoutInactive(draft, clock + 3600000)) fail('inactivity_boundary');
if (activity.stampWorkoutActivity(draft, { ...draft }, clock + 3000000).lastActivityAt !== clock) fail('passive_activity');
const closed = activity.inactivityFinishMetadata(draft, clock + 3600000);
if (closed.end !== clock || closed.finishedAt !== clock + 3600000 || closed.finishReason !== 'inactivity_timeout') fail('inactivity_duration');
console.log('INACTIVITY_MODEL_PROBE=OK deadline=60min passive_no_reset duration_excludes_idle');
const store = await import(B + 'lib/blocks-store.js');
const P = await import(B + 'lib/protocol/index.js');
const meta = await import(B + 'lib/plan-meta.js');
const gate = await import(B + 'coach/protocol-gate.js');
if (P.PROTOCOL_VERSION !== '1.0') fail('protocol_version');
if (typeof P.savePolicy !== 'function' || P.OVERRIDE_REASON_MIN !== 8) fail('save_policy_export');
// ---- official library: 155 MASTER blocks (118 of V2.1 + 37 guided masters for Guided Routines V1),
// all PASS, curated (or cardio machines), no unverified. Copies inside guided routines are NOT masters.
const MASTERS = 198;
const info = store.seedInfo();
if (info.protocolVersion !== '1.0' || info.count !== MASTERS) fail('seed_info');
const seed = JSON.parse(fs.readFileSync(new URL(B + 'lib/blocks-official.json'), 'utf8'));
const ids = new Set(seed.blocks.map(b => b.id));
if (seed.blocks.length !== MASTERS || ids.size !== MASTERS) fail('seed_count');
const sig = b => b.type + '|' + JSON.stringify(b.timing || null) + '|' + b.ex.map(e => e.id).join(',');
if (new Set(seed.blocks.map(sig)).size !== MASTERS) fail('master_content_duplicate');
let pass = 0, withReason = 0;
for (const b of seed.blocks) {
  if (!b.id.startsWith('off-') || b.official !== true) fail('seed_shape:' + b.id);
  if (!b.ex.every(e => P.CATALOG[e.id] || P.classify(e.id, store.lookup).cardio || store.lookup(e.id)?.bp === 'cardio')) fail('seed_uncurated:' + b.id);
  const v = store.check(b, { official: true });
  if (v.result === 'FAIL') fail('seed_fail:' + b.id);
  if (v.issues.some(i => i.severity === 'unverified')) fail('seed_unverified:' + b.id);
  if (v.result === 'PASS') pass++; else withReason++;
}
if (pass !== MASTERS || withReason !== 0) fail('seed_not_all_pass');
// what GET /api/blocks lists (admin view of an id without personal blocks): exactly the 155 masters
const listed = store.listFor('__deploy_probe__', true).blocks;
if (listed.filter(b => ids.has(b.id)).length !== MASTERS) fail('api_blocks_masters');
// ---- the six guided official blocks of V2.1 are still there, with valid timing (43 guided masters now)
const GUIDED = { 'off-fullbody-endurance-beginner-x-circuit': 'circuit', 'off-abs-general-intermediate-x-circuit': 'circuit',
  'off-cardio-general-intermediate-x-interval': 'interval', 'off-cardio-general-advanced-x-hiit': 'hiit',
  'off-fullbody-general-beginner-x-mobility': 'mobility', 'off-lower-general-intermediate-x-mobility': 'mobility' };
const guided = seed.blocks.filter(b => P.isGuided(b.type));
if (guided.length !== 86) fail('guided_count');
for (const b of guided) {
  if (JSON.stringify(P.sanitizeTiming(b.timing, b.type)) !== JSON.stringify(b.timing)) fail('guided_timing_invalid:' + b.id);
  if (b.timing.rounds < 1 || b.timing.rounds > 10 || !b.ex.every(e => e.sets === b.timing.rounds)) fail('guided_rounds:' + b.id);
}
for (const [id, type] of Object.entries(GUIDED)) {
  const b = seed.blocks.find(x => x.id === id);
  if (!b || b.type !== type) fail('guided_missing:' + id);
  if (JSON.stringify(P.sanitizeTiming(b.timing, b.type)) !== JSON.stringify(b.timing)) fail('guided_timing_invalid:' + id);
  if (b.timing.rounds < 1 || b.timing.rounds > 10 || !b.ex.every(e => e.sets === b.timing.rounds)) fail('guided_rounds:' + id);
}
// ---- timing model: rounds 1-10, Tabata is an editable preset (not hardcoded 20/10), circuit mixes modes
if (P.sanitizeTiming({ rounds: 99 }, 'hiit').rounds !== 10 || P.sanitizeTiming({ rounds: 0 }, 'hiit').rounds !== 1) fail('rounds_clamp');
const tab = P.sanitizeTiming({ preset: 'tabata', work: 30, rest: 15, rounds: 6 }, 'hiit');
if (tab.work !== 30 || tab.rest !== 15 || tab.rounds !== 6 || tab.preset !== 'tabata') fail('tabata_not_editable');
if (P.sanitizeTiming({ work: 30 }, 'strength') !== null) fail('timing_on_strength');
const mixed = P.applyTiming([{ id: '0175', sets: 3, mode: 'reps', reps: 15 }, { id: '2135', sets: 3, mode: 'time', sec: 45 }], 'circuit', { work: 30, rounds: 4 });
if (mixed[0].mode !== 'reps' || mixed[0].reps !== 15 || mixed[1].mode !== 'time' || mixed[1].sec !== 30 || mixed[0].sets !== 4) fail('circuit_mix');
// ---- 2J-HEU-INTERVAL-ROUNDS: interval rounds and mobility are never direct weekly sets
if (!P.RULE_BY_ID['2J-HEU-INTERVAL-ROUNDS']) fail('heuristic_missing');
const lk = { lookup: store.lookup };
const hiitDay = [{ id: '0514', sets: 8, mode: 'time', sec: 20, blk: 'k1' }, { id: '0043', sets: 3, mode: 'reps', reps: 8, blk: 'k2' }];
const vh = P.validateAgainst2JProtocol({ kind: 'routine', goal: 'hypertrophy', level: 'intermediate', entries: hiitDay, blockTypes: { k1: 'hiit', k2: 'strength' } }, lk);
if (vh.issues.some(i => i.code === 'sets_outside_allowed') || vh.stats.weeklySets.quads !== 3) fail('hiit_rounds_counted');
if (P.validateAgainst2JProtocol({ kind: 'routine', goal: 'hypertrophy', level: 'intermediate', entries: hiitDay }, lk).result !== 'FAIL') fail('block_type_ignored');
const tooMany = P.validateAgainst2JProtocol({ kind: 'block', goal: 'general', level: 'intermediate', type: 'hiit', entries: [{ id: '0514', sets: 12, mode: 'time', sec: 20 }] }, lk);
if (!tooMany.issues.some(i => i.code === 'rounds_outside_allowed' && i.severity === 'fail')) fail('rounds_limit');
const mob = P.validateAgainst2JProtocol({ kind: 'routine', goal: 'general', level: 'beginner', entries: [{ id: '1604', sets: 1, mode: 'time', sec: 40, blk: 'm' }], blockTypes: { m: 'mobility' } }, lk);
if (Object.keys(mob.stats.weeklySets).length) fail('mobility_counted');
// the save policy (API) uses the block types too, and restrictions stay non-overridable inside them
if (meta.enforcePlanPolicy([hiitDay.slice(0, 1)], meta.sanitizePlanMeta({ goal: 'general', level: 'intermediate' }), { k1: 'hiit' }) !== null) fail('api_policy_rounds');
const rj = meta.enforcePlanPolicy([hiitDay.slice(0, 1)], meta.sanitizePlanMeta({ goal: 'general', level: 'intermediate', restrictions: ['no-jumps'] }), { k1: 'hiit' });
if (!rj || rj.status !== 400) fail('api_policy_restriction');
// ---- AI knows guided blocks; the validator stays the authority
const offer = store.compatibleOfficial({ goal: 'general', level: 'advanced', max: 60 }).find(b => b.id === 'off-cardio-general-advanced-x-hiit');
if (!offer || offer.type !== 'hiit' || offer.timing?.rounds !== 8) fail('ai_guided_offer');
const exp = gate.expandBlocks({ routines: [{ id: 'r1', name: 'x', blocks: ['off-cardio-general-advanced-x-hiit'], ex: [] }] });
if (exp.errors.length || exp.data.routines[0]._blockMeta[0].timing?.rounds !== 8) fail('ai_guided_expand');
const aiPlan = { name: 'p', routines: [{ id: 'r1', name: 'x', ex: exp.data.routines[0].ex, blocks: exp.data.routines[0]._blockMeta }], week: { 1: 'r1' } };
if (gate.gatePlan(aiPlan, { goal: 'general', level: 'advanced', restrictions: [], unavailableEq: [] }).ok !== true) fail('ai_guided_rejected');
const jumpPlan = { name: 'p', routines: [{ id: 'r1', name: 'x', ex: [{ id: '0514', sets: 8, mode: 'time', sec: 20, blk: 'k1' }], blocks: [{ iid: 'k1', type: 'hiit' }] }], week: { 1: 'r1' } };
if (gate.gatePlan(jumpPlan, { goal: 'general', level: 'advanced', restrictions: ['no-jumps'], unavailableEq: [] }).ok !== false) fail('ai_restriction_in_guided');
// ---- barbell hip thrust = 0058, the floor glute bridge 1409 stays separate, no duplicate
const ht = store.lookup('0058'), gb = store.lookup('1409');
if (!ht || ht.n !== 'barbell hip thrust' || ht.eq !== 'barbell') fail('hip_thrust_0058');
if (!gb || gb.n !== 'barbell glute bridge') fail('glute_bridge_1409');
const lib = JSON.parse(fs.readFileSync(new URL(B + 'coach/library.json'), 'utf8')).exercises;
if (lib.filter(e => /hip thrust/.test(e.n) && e.eq === 'barbell').length !== 1) fail('hip_thrust_duplicate');
const c58 = P.classify('0058', store.lookup), c09 = P.classify('1409', store.lookup);
if (!c58.curated || c58.pattern !== 'bridge' || P.redundancyKey(c58) === P.redundancyKey(c09)) fail('hip_thrust_curation');
if (!['off-glutes-hypertrophy-intermediate-a', 'off-glutes-hypertrophy-advanced-a'].every(id => seed.blocks.find(b => b.id === id)?.ex.some(e => e.id === '0058'))) fail('hip_thrust_blocks');
// ---- V2 save policy and AI gate (unchanged)
const squat = [{ id: '0043', sets: 3, mode: 'reps', reps: 10, targetRepsMin: 6, targetRepsMax: 10, rpe: [8, 8, 8], rest: 150 }];
const allOut = [{ id: '0585', sets: 3, mode: 'reps', reps: 12, rpe: [10, 10, 10] }, { id: '0294', sets: 3, mode: 'reps', reps: 12, rpe: [10, 10, 10] }];
const hyp = { goal: 'hypertrophy', level: 'intermediate' };
const enforce = (ex, m) => meta.enforcePlanPolicy([ex], meta.sanitizePlanMeta(m));
const restricted = enforce(squat, { ...hyp, restrictions: ['no-deep-knee-flexion'], override: { reason: 'Smoke probe reason text', codes: ['restriction'] } });
if (!restricted || restricted.status !== 400 || !P.savePolicy(restricted.validation).blocked.length) fail('restriction_overridable');
const noReason = enforce(allOut, hyp);
if (!noReason || noReason.status !== 400 || !P.savePolicy(noReason.validation).needsReason) fail('fail_without_reason_saved');
const shortReason = enforce(allOut, { ...hyp, override: { reason: 'short' } });
if (!shortReason || shortReason.status !== 400) fail('short_reason_accepted');
if (enforce(allOut, { ...hyp, override: { reason: 'Smoke probe reason text', codes: ['rpe10_all'] } }) !== null) fail('override_with_reason_rejected');
if (meta.enforcePlanPolicy([allOut], null) !== null) fail('legacy_path_changed');
const plan = ex => ({ name: 'probe', routines: [{ id: 'r1', name: 'probe', ex }], week: { 1: 'r1' } });
if (gate.gatePlan(plan(allOut), { ...hyp, restrictions: [], unavailableEq: [] }).ok !== false) fail('ai_fail_accepted');
if (gate.gatePlan(plan(squat), { ...hyp, restrictions: ['no-deep-knee-flexion'], unavailableEq: [] }).ok !== false) fail('ai_restriction_accepted');
const guessed = plan([{ id: '3543', sets: 3, mode: 'reps', reps: 5 }]);
const g = gate.gatePlan(guessed, { goal: 'general', level: 'intermediate', restrictions: ['no-jumps'], unavailableEq: [] });
if (g.ok !== false || !g.errors.join(' ').includes('restriction_unverified')) fail('ai_unverified_accepted');
// ---- Guided Routines V1: 39 official routines + 7 collections + 3 featured, composed of masters
const G = await import(B + 'lib/guided-store.js');
const gseed = JSON.parse(fs.readFileSync(new URL(B + 'lib/guided-official.json'), 'utf8'));
const gi = G.seedInfo();
if (gi.protocolVersion !== '1.0' || gi.seedVersion !== 1 || gi.count !== 155 || gi.collections !== 15) fail('guided_seed_info');
if (gseed.routines.length !== 155 || gseed.collections.length !== 15) fail('guided_seed_count');
const rids = new Set(gseed.routines.map(r => r.id));
const cids = new Set(gseed.collections.map(c => c.id));
if (rids.size !== 155 || cids.size !== 15 || ![...rids].every(id => id.startsWith('r2j-')) || ![...cids].every(id => id.startsWith('c2j-'))) fail('guided_ids');
const iids = gseed.routines.flatMap(r => r.blocks.map(b => b.iid));
if (new Set(iids).size !== iids.length) fail('guided_copy_ids');
const allIds = [...ids, ...rids, ...cids, ...iids];
if (new Set(allIds).size !== allIds.length) fail('id_collision');
if (listed.some(b => rids.has(b.id) || iids.includes(b.id) || b.id.startsWith('r2j'))) fail('routine_copies_in_api_blocks');
const featured = gseed.routines.filter(r => r.featured);
if (featured.length !== 3) fail('guided_featured');
const usedMasters = new Set();
for (const r of gseed.routines) {
  if (r.official !== true || r.seedVersion !== 1 || r.validation?.result !== 'PASS') fail('guided_shape:' + r.id);
  const v = G.check(r, { official: true });
  if (v.result !== 'PASS') fail('guided_not_pass:' + r.id);
  if (v.issues.some(i => i.severity === 'unverified')) fail('guided_unverified:' + r.id);
  for (const b of r.blocks) { if (!ids.has(b.src)) fail('guided_bad_master:' + r.id); usedMasters.add(b.src); }
  if (!r.ex.every(e => r.blocks.some(b => b.iid === e.blk))) fail('guided_orphan_entry:' + r.id);
  const f = P.routineFacts(r, store.lookup, r.tags.includes('low-impact') ? ['low-impact'] : []);
  if (f.minutes !== r.estimatedMinutes || JSON.stringify(f.equipment) !== JSON.stringify(r.equipment) || JSON.stringify(f.tags) !== JSON.stringify(r.tags)) fail('guided_facts:' + r.id);
}
if (usedMasters.size !== 145) fail('guided_masters_used');
for (const c of gseed.collections) if (!c.routineIds.length || !c.routineIds.every(id => rids.has(id))) fail('collection_refs:' + c.id);
// what GET /api/guided returns (read-only): every seed routine for an admin; members never see "mine"
const adminView = G.listFor({ id: '__deploy_probe__' }, { admin: true, trainer: true });
if (![...rids].every(id => adminView.routines.some(r => r.id === id))) fail('guided_list_admin');
const memberView = G.listFor({ id: '__deploy_probe__' }, {});
if (memberView.mine.length !== 0 || memberView.routines.some(r => r.active === false)) fail('guided_list_member');
const programs = JSON.parse(fs.readFileSync(new URL(B + 'lib/guided-programs-official.json'), 'utf8')).programs;
if (programs.length !== 22 || adminView.programs.length < 22 || memberView.programs.length > adminView.programs.length) fail('program_count');
for (const p of programs) {
  if (!p.weeks?.length || !p.weeks.every(w => w.sessions?.length && w.sessions.every(s => rids.has(s.routineId)))) fail('program_refs:' + p.id);
}
// a protocol FAIL is refused before anything is stored (pure check, nothing saved)
const badR = { goal: 'power', level: 'advanced', ex: [{ id: '0514', sets: 3, mode: 'reps', reps: 5, rpe: [10, 10, 10] }], blocks: [] };
if (G.check(badR, { official: false }).result !== 'FAIL') fail('guided_fail_not_detected');
// the AI receives compact official routines built from masters
const pay = gate.protocolPayload({ goal: 'general', level: 'beginner', restrictions: [], unavailableEq: [] });
if (!pay.officialRoutines?.length || !pay.officialRoutines.every(r => rids.has(r.id) && r.blocks.every(id => ids.has(id)))) fail('ai_official_routines');
// ---- treadmill: 0684 and 3666 carry their real equipment in the library itself (same ids/names)
const t84 = store.lookup('0684'), t66 = store.lookup('3666');
if (!t84 || t84.n !== 'treadmill run' || t84.eq !== 'treadmill') fail('treadmill_0684');
if (!t66 || t66.n !== 'walking on incline treadmill' || t66.eq !== 'treadmill') fail('treadmill_3666');
const tm = seed.blocks.filter(b => b.ex.some(e => e.id === '0684' || e.id === '3666'));
if (tm.length !== 6 || !tm.every(b => (b.equipment || []).includes('treadmill'))) fail('treadmill_blocks');
const tr = gseed.routines.filter(r => r.ex.some(e => e.id === '0684' || e.id === '3666'));
if (tr.length !== 8 || !tr.every(r => r.equipment.includes('treadmill') && !r.tags.includes('no-equipment'))) fail('treadmill_routines');
if ('GEAR_OVERRIDE' in P || 'equipmentOf' in P) fail('gear_override_left');
// ---- Exercise Library V2: AI index, taxonomy, deprecations, the Coach slice, classifier, validator
const payload = await import(B + 'coach/payload.js');
const gym = await import(B + 'lib/gym-profiles.js');
const gymConfig = await import(B + 'lib/gym-profile-config.js');
const configuredEquipment = gymConfig.load();
const configPath = (process.env.DATA_DIR || '/data') + '/gym-profile.json';
const gymTaxonomy = await import(B + 'lib/protocol/movements.js');
const equipmentIds = new Set(gymTaxonomy.EQUIPMENT.map(e => e.id));
if (!Array.isArray(configuredEquipment) || configuredEquipment.some(id => !equipmentIds.has(id)) || configuredEquipment.length > 19) fail('gym_official_config_shape');
if (!fs.existsSync(configPath) && JSON.stringify(configuredEquipment) !== JSON.stringify(gym.DEFAULT_2J_EQUIPMENT)) fail('gym_official_fallback');
if (process.env.GYM_CONFIG_EXPECT === 'custom' && JSON.stringify(configuredEquipment) !== JSON.stringify(['bodyweight', 'smith'])) fail('gym_official_persisted_read');
const LIB = payload.LIBRARY;
const libById = new Map(LIB.map(e => [e.id, e]));
if (LIB.length !== 1324 || libById.size !== 1324) fail('lib_ids');
const recN = LIB.filter(e => e.rec).length, mvN = LIB.filter(e => e.mv).length, depL = LIB.filter(e => e.pref);
const overlayRev0 = (await import(B + 'lib/library-admin.js')).overlay().rev;
// The code library is exactly these numbers; once an admin has edited the overlay it may legitimately differ.
if (overlayRev0 === 0 && (recN !== 210 || mvN !== 1305 || depL.length !== 26)) fail(`lib_counts:${recN}/${mvN}/${depL.length}`);
if (P.MOVEMENTS.length !== 35 || P.EQUIPMENT.length !== 28 || P.EQUIPMENT_KINDS.length !== 6) fail('taxonomy_counts');
const mvIds = new Set(P.MOVEMENTS.map(m => m.id));
if (!LIB.every(e => !e.mv || mvIds.has(e.mv))) fail('lib_movement_invalid');
if (!LIB.every(e => P.EQUIPMENT_BY_ID[P.equipmentIdOf(e)])) fail('lib_equipment_invalid');
const officialEx = new Set([...seed.blocks.flatMap(b => b.ex.map(e => e.id)), ...gseed.routines.flatMap(r => r.ex.map(e => e.id))]);
for (const e of depL) {
  const pr = libById.get(e.pref);
  if (!pr || pr.pref || pr.mv !== e.mv) fail('deprecated_preferred:' + e.id);
  if (officialEx.has(e.id)) fail('deprecated_in_official_seed:' + e.id);
}
const slice = payload.librarySlice({}, []);
if (slice.some(e => e.pref)) fail('ai_offers_deprecated');
const gymState = { coach: {}, workouts: [], routines: [], programs: [], week: {}, dayPlan: {},
  gymProfiles: { activeId: 'hotel' } };
const gymContext = gym.gymEquipmentContext(gymState);
if (!gymContext.availableEquipment.includes('bodyweight') || gymContext.type !== 'hotel'
  || gymContext.scope !== 'equipment_categories_not_machine_inventory') fail('gym_context');
const gymPayload = payload.build(gymState, '__deploy_probe__', {});
if (gymPayload.gymProfile?.type !== 'hotel' || !gymPayload.gymProfile.availableEquipment.includes('bodyweight'))
  fail('gym_ai_context');
const gymSlice = payload.librarySlice(gymState, []);
if (P.equipmentIdOf(gymSlice[0]) !== 'bodyweight') fail('gym_compatible_not_first');
// Policy: recommended > non-recommended inside what the gym offers. The gym blacklist
// (DATA/hidden-exercises.json, read-only here, the same file librarySlice reads) legitimately
// removes exercises, so the expected count comes from the data, never from a fixed floor.
let hiddenEx = new Set();
try { const h = JSON.parse(fs.readFileSync((process.env.DATA_DIR || '/data') + '/hidden-exercises.json', 'utf8')); if (Array.isArray(h)) hiddenEx = new Set(h); } catch { /* absent = nothing hidden */ }
const expectedRec = LIB.filter(e => e.rec && !e.pref && !hiddenEx.has(e.id)).length;
const expectedAll = LIB.filter(e => !e.pref && !hiddenEx.has(e.id)).length;
const recInSlice = slice.filter(e => e.rec).length, firstNonRec = slice.findIndex(e => !e.rec);
if (recInSlice !== expectedRec || slice.length !== expectedAll || slice.some(e => hiddenEx.has(e.id))
  || (firstNonRec !== -1 && firstNonRec !== recInSlice) || (firstNonRec === -1 && recInSlice !== slice.length))
  fail(`ai_recommended_first:rec=${recInSlice}/${expectedRec} first_non_rec=${firstNonRec} slice=${slice.length}/${expectedAll} hidden=${hiddenEx.size}`);
if (!payload.libraryHas(depL[0].id)) fail('old_plan_id_unresolvable');
const pat = id => P.classify(id, store.lookup).pattern;
if (pat('0705') !== 'anti-lat' || pat('2466') !== 'cond-climber' || pat('3645') !== 'bridge' || pat('0058') !== 'bridge'
  || pat('0125') !== 'wrist' || pat('0031') !== 'curl' || pat('1259') !== 'mobility') fail('classifier_regression');
if (P.classify('1259', store.lookup).group !== null) fail('stretch_counts_as_volume');
const vo = P.validateAgainst2JProtocol({ kind: 'routine', goal: 'hypertrophy', level: 'intermediate',
  entries: [{ id: '0289', sets: 3, mode: 'reps', reps: 10 }, { id: '0296', sets: 3, mode: 'reps', reps: 10 }] }, { lookup: store.lookup });
if (vo.result !== 'PASS' || !vo.issues.some(i => i.code === 'high_overlap' && i.severity === 'note')) fail('high_overlap_note');
// ---- Sprint 4.5 release safety. Read-only: DATA_DIR points nowhere while any call that could write runs,
// so an unexpected write throws here instead of touching production data.
const LA = await import(B + 'lib/library-admin.js');
const realDir = process.env.DATA_DIR;
const guidedFile = (realDir || '/data') + '/guided.json', libFile = (realDir || '/data') + '/library-admin.json';
const snap = f => { try { const st = fs.statSync(f); return st.size + ':' + st.mtimeMs; } catch { return 'absent'; } };
const filesBefore = JSON.stringify([snap(guidedFile), snap(libFile)]);
const overlayRev = LA.overlay().rev;
if (!Number.isInteger(overlayRev) || overlayRev < 0) fail('overlay_rev');
const pubOverlay = LA.publicOverlay();
if (pubOverlay.v !== 1 || pubOverlay.rev !== overlayRev || typeof pubOverlay.entries !== 'object' || JSON.stringify(pubOverlay).includes('"note"')) fail('public_overlay_shape');
const guidedRev = G.contentRev();
if (!/^\d+\.\d+\.\d+$/.test(guidedRev)) fail('guided_rev_shape');
process.env.DATA_DIR = '/nonexistent-2j-readonly-probe';
try {
  const probeMember = { id: '__deploy_probe_member__' };
  const officialInput = { scope: 'official', name: 'Probe', category: 'strength', goal: 'general', level: 'beginner', focus: 'upper', status: 'active', ex: [{ id: '0043', sets: 3, mode: 'reps', reps: 8 }] };
  for (const [what, r] of [['upsert', G.upsert(probeMember, false, officialInput)], ['status', G.setStatus(probeMember, false, 'r2j-tabata-start', 'hidden')],
    ['active', G.setActive(probeMember, false, 'r2j-tabata-start', false)], ['remove', G.remove(probeMember, false, 'r2j-tabata-start')]]) {
    if (!r || r.status !== 403 || !r.error) fail('member_write_not_refused:' + what);
  }
  const depIds = new Set(LIB.filter(e => e.pref).map(e => e.id));
  const routineById = new Map(gseed.routines.map(r => [r.id, r]));
  let aiOffered = 0;
  for (const goal of ['general', 'hypertrophy', 'strength', 'endurance', 'beginner']) for (const level of ['beginner', 'intermediate', 'advanced']) {
    for (const c of G.compatibleRoutines({ goal, level, max: 500 })) {
      const full = routineById.get(c.id);
      if (!full) continue;
      aiOffered++;
      if (full.ex.some(e => depIds.has(e.id))) fail('ai_routine_uses_deprecated:' + c.id);
    }
    for (const c of G.compatiblePrograms({ goal, level })) {
      const full = programs.find(p => p.id === c.id);
      for (const w of full?.weeks || []) for (const sess of w.sessions) if (routineById.get(sess.routineId)?.ex.some(e => depIds.has(e.id))) fail('ai_program_uses_deprecated:' + c.id);
    }
  }
  if (!aiOffered) fail('ai_offers_no_official_routine');
  if (slice.some(e => depIds.has(e.id))) fail('ai_library_slice_deprecated');
} finally {
  if (realDir === undefined) delete process.env.DATA_DIR; else process.env.DATA_DIR = realDir;
}
if (JSON.stringify([snap(guidedFile), snap(libFile)]) !== filesBefore) fail('probe_wrote_data');
console.log('PROBE_OK');
console.log(`PROBE_DATA exlib=${LIB.length} recommended=${recN} with_movement=${mvN} deprecated=${depL.length} movements=${P.MOVEMENTS.length} equipment=${P.EQUIPMENT.length} kinds=${P.EQUIPMENT_KINDS.length} ai_rec_first=${recInSlice} hidden_ex=${hiddenEx.size} gym_profiles=ok gym_config_source=${fs.existsSync(configPath) ? "persisted" : "fallback"} gym_ai_context=hotel gym_compatible_first=bodyweight protocol=${P.PROTOCOL_VERSION} masters=${info.count} pass=${pass} pass_with_reason=${withReason} fail=0 unverified=0 api_blocks=${listed.filter(b => ids.has(b.id)).length} guided_masters=${guided.length} routines=${gseed.routines.length} programs=${programs.length} collections=${gseed.collections.length} featured=${featured.length} masters_used=${usedMasters.size} copies=${iids.length} treadmill=0684+3666 rounds=1-10 tabata=editable circuit=mixed interval_rounds=not_volume mobility=not_volume ai_guided=offered hip_thrust=0058 glute_bridge=1409 restriction=blocked fail_needs_reason=yes ai_fail=rejected ai_unverified=rejected member_writes=refused ai_deprecated=0 overlay_rev=${overlayRev} guided_rev=${guidedRev}`);
JS
}

write_mutable_data_probe() {
  cat > "$1" <<'JS'
import fs from 'node:fs';
import path from 'node:path';
const dir = process.env.DATA_DIR || '/data';
const required = new Set((process.env.REQUIRED_MUTABLE_FILES || '').split(',').filter(Boolean));
const specs = {
  'db.json': { users: 'array' },
  'notifications.json': { items: 'array', privacy: 'object', preferences: 'object' },
  'friends.json': { codes: 'array', requests: 'array', blocked: 'array' },
  'chat.json': { threads: 'array', messages: 'array' },
  'social.json': { routines: 'array', programs: 'array', wall: 'array' },
  'social-sharing.json': { shares: 'array', reports: 'array' },
  'blocks.json': {}, 'guided.json': {}, 'library-admin.json': {}, 'news.json': { items: 'array' }, 'features.json': { off: 'array' }, 'gym-profile.json': { availableEquipment: 'array' },
};
const fail = (name, why) => { console.error(`MUTABLE_DATA_INVALID=${name} reason=${why}`); process.exitCode = 1; };
// chat.json is AES-GCM at rest since Sprint 3 (legacy plaintext JSON is still accepted). The encrypted form is validated with the
// application's OWN crypto layer and the live key, never with a copy of it; only PASS/FAIL and the reason are printed, never content.
const cryptoModule = process.env.MUTABLE_CRYPTO_MODULE || '/app/lib/crypto.js';
let cryptoLayer = null;
const readEncryptedChat = async text => {
  cryptoLayer = cryptoLayer || await import(cryptoModule.startsWith('file:') ? cryptoModule : (await import('node:url')).pathToFileURL(cryptoModule).href);
  const value = cryptoLayer.decrypt(text, 'chat-store');   // null on a wrong key, tampering or corruption
  if (!value) throw new Error('encrypted_unreadable');
  return value;
};
for (const [name, fields] of Object.entries(specs)) {
  const file = path.join(dir, name);
  if (!fs.existsSync(file)) { if (required.has(name)) fail(name, 'missing'); continue; }
  let value;
  try {
    const raw = fs.readFileSync(file, 'utf8');
    if (raw.trim().length < 3) throw new Error('empty_or_truncated');
    value = (name === 'chat.json' && !raw.trim().startsWith('{')) ? await readEncryptedChat(raw.trim()) : JSON.parse(raw);
  } catch (e) { fail(name, e && e.message === 'encrypted_unreadable' ? 'encrypted_unreadable' : 'invalid_json_or_empty'); continue; }
  if (!value || typeof value !== 'object' || Array.isArray(value) || !Object.keys(value).length) {
    fail(name, 'invalid_root'); continue;
  }
  const strict = name === 'db.json' || name === 'gym-profile.json';
  if (!strict && Object.keys(fields).length && !Object.keys(fields).some(key => key in value)) {
    fail(name, 'missing_known_fields'); continue;
  }
  for (const [key, kind] of Object.entries(fields)) {
    if (!strict && !(key in value)) continue;
    if (kind === 'array' ? !Array.isArray(value[key]) : !value[key] || typeof value[key] !== 'object' || Array.isArray(value[key])) {
      fail(name, `invalid_${key}`);
    }
  }
}
if (!process.exitCode) console.log('COMMUNITY_MUTABLE_DATA=preserved-valid');
JS
}

verify_poststart_data() {
  local name file meta mode probe_file
  test -d "$APP/data" && test -s "$APP/data/db.json" && test -s "$APP/data/secret"
  [[ "$(stat -c '%d:%i' "$APP/data")" == "$DATA_DIR_ID_BEFORE" ]]
  [[ "$(stat -c '%U:%G' "$APP/data")" == "$DATA_OWNER_BEFORE" ]]
  [[ "$(stat -c '%a' "$APP/data")" == "$DATA_MODE_BEFORE" ]]
  [[ "$(sha256sum "$APP/data/secret" | awk '{print $1}')" == "$SECRET_HASH_BEFORE" ]]
  [[ "$(sha256sum "$APP/.env" | awk '{print $1}')" == "$ENV_HASH_BEFORE" ]]
  if [[ "$VAPID_BEFORE" == present ]]; then
    test -s "$APP/data/vapid.json"
    [[ "$(sha256sum "$APP/data/vapid.json" | awk '{print $1}')" == "$VAPID_HASH_BEFORE" ]]
  fi
  for name in db.json notifications.json friends.json chat.json social.json social-sharing.json blocks.json guided.json library-admin.json news.json features.json gym-profile.json; do
    file="$APP/data/$name"
    if [[ ${MUTABLE_META_BEFORE[$name]+set} ]]; then
      test -s "$file"
      [[ "$(stat -c '%U:%G:%a' "$file")" == "${MUTABLE_META_BEFORE[$name]}" ]]
    elif [[ -e "$file" ]]; then
      test -s "$file"
      [[ "$(stat -c '%U:%G' "$file")" == "$DATA_OWNER_BEFORE" ]]
      mode=$(stat -c '%a' "$file")
      (( (8#$mode & 022) == 0 ))
    fi
  done
  probe_file=$(mktemp /tmp/2j-mutable-data-probe.XXXXXX)
  write_mutable_data_probe "$probe_file"
  "${COMPOSE[@]}" exec -T -e "REQUIRED_MUTABLE_FILES=$REQUIRED_MUTABLE_FILES" api node --input-type=module - < "$probe_file"
  rm -f -- "$probe_file"
  printf 'COMMUNITY_POSTSTART_HASH_CHECK=skipped-live-mutable\n'
  printf 'IMMUTABLE_DATA_HASHES=OK secret,.env,vapid:%s\n' "$VAPID_BEFORE"
}

remove_obsolete_release_files() {
  local old_archive=$1 new_archive=$2 old_list new_list
  old_list=$(mktemp /tmp/2j-old-release.XXXXXX)
  new_list=$(mktemp /tmp/2j-new-release.XXXXXX)
  tar -tzf "$old_archive" | sort > "$old_list"
  tar -tzf "$new_archive" | sort > "$new_list"
  while IFS= read -r rel; do
    [[ -z "$rel" || "$rel" == */ || "$rel" == data || "$rel" == data/* ]] && continue
    rm -f -- "$APP/$rel"
  done < <(comm -23 "$old_list" "$new_list")
  # Directories that only the outgoing release had, deepest first, once empty: the code tree ends
  # up exactly as the incoming archive (before this, a rollback left them behind, empty, and the
  # next deploy's verify-current-production stopped on them). data/ is never touched; a directory
  # that still holds something is left in place and reported, never force-removed.
  while IFS= read -r rel; do
    [[ -z "$rel" || "$rel" == data/ || "$rel" == data/* ]] && continue
    [[ -d "$APP/$rel" ]] || continue
    rmdir -- "$APP/$rel" 2>/dev/null || { printf 'ORPHAN_DIR_NOT_EMPTY=%s\n' "$rel" >&2; return 1; }
  done < <(comm -23 "$old_list" "$new_list" | grep '/$' | sort -r)
  rm -f -- "$old_list" "$new_list"
}

verify_archive_tree() {
  local archive=$1 expected rel bad=0 extras
  expected=$(mktemp -d /tmp/2j-verify-tree.XXXXXX)
  tar -xzf "$archive" -C "$expected" || { rm -rf -- "$expected"; return 1; }
  while IFS= read -r rel; do
    [[ -z "$rel" || "$rel" == */ ]] && continue
    if [[ -L "$expected/$rel" ]]; then
      [[ -L "$APP/$rel" && "$(readlink "$expected/$rel")" == "$(readlink "$APP/$rel")" ]] || { printf 'TREE_MISMATCH=%s\n' "$rel"; bad=1; }
    elif [[ ! -f "$APP/$rel" || -L "$APP/$rel" ]] || ! cmp -s "$expected/$rel" "$APP/$rel"; then
      printf 'TREE_MISMATCH=%s\n' "$rel"; bad=1
    fi
  done < <(tar -tzf "$archive")
  extras=$(cd "$APP" && find frontend api scripts web \
    \( -type d \( -name node_modules -o -name dist -o -name coverage -o -name .cache -o -name .vite -o -name build -o -name .next \) -prune \) -o \
    \( -type f -o -type l \) -print | sort | comm -23 - <(tar -tzf "$archive" | awk '!/\/$/' | sort))
  if [[ -n "$extras" ]]; then printf 'EXTRA_CODE_FILE=%s\n' "$extras"; bad=1; fi
  rm -rf -- "$expected"
  (( bad == 0 ))
}

# Last step of every rollback: put the PRODUCTION MARKER back to the rollback commit and prove it. The next deployment's pre-flight compares this
# marker with the baseline it was built for, so a rollback that leaves the target's marker behind is not a clean rollback. Runs after compose and
# the health check so nothing in between can leave the target's marker in place; a mismatch makes the rollback report FAILED.
finish_rollback_verification() {
  local extract_status=$1 compose_status=$2 tree_status=$3 rollback_health=$4 residue=$5 residue_dirs=$6
  local marker_status=0
  printf '%s\n' "$ROLLBACK_COMMIT" > "$APP/.deployed-commit" || marker_status=1
  [[ "$(cat "$APP/.deployed-commit" 2>/dev/null)" == "$ROLLBACK_COMMIT" ]] || marker_status=1
  if [[ $marker_status -eq 0 ]]; then
    printf 'ROLLBACK_MARKER=ok:%s\n' "$ROLLBACK_COMMIT"
  else
    printf 'ROLLBACK_MARKER=MISMATCH expected=%s\n' "$ROLLBACK_COMMIT"
  fi
  if [[ $extract_status -eq 0 && $compose_status -eq 0 && $tree_status -eq 0 && "$rollback_health" == 200 && -z "$residue" && -z "$residue_dirs" && $marker_status -eq 0 ]]; then
    printf 'ROLLBACK=OK:%s\n' "$ROLLBACK_COMMIT"
    return 0
  fi
  printf 'ROLLBACK=FAILED:extract=%s,compose=%s,marker=%s\n' "$extract_status" "$compose_status" "$marker_status"
  return 1
}

rollback() {
  local original_status=$1 original_command=$2 original_step=$3
  trap - ERR
  set +e
  printf 'ORIGINAL_FAIL_STEP=%s\n' "$original_step"
  printf 'ORIGINAL_STATUS=%s\n' "$original_status"
  printf 'ORIGINAL_COMMAND=%s\n' "$original_command"
  if [[ "$DEPLOY_STARTED" != 1 ]]; then
    printf 'ROLLBACK=NOT_NEEDED_PRODUCTION_UNTOUCHED\n'
    exit "$original_status"
  fi

  cd "$APP" || true
  "${COMPOSE[@]}" logs --tail=80 --no-color api web caddy || true
  if ! remove_obsolete_release_files "$RELEASE" "$ROLLBACK"; then
    printf 'ROLLBACK=FAILED:ORPHAN_DIR_NOT_EMPTY\n'
    exit "$original_status"
  fi
  tar -xzf "$ROLLBACK" -C "$APP"
  local extract_status=$?
  if [[ $extract_status -eq 0 ]]; then chown_archive_files "$ROLLBACK"; fi
  # The code tree must now be exactly the rollback archive: no path that only the target had.
  local residue='' residue_dirs=''
  while IFS= read -r rel; do
    [[ -z "$rel" || "$rel" == */ || "$rel" == data/ || "$rel" == data/* ]] && continue
    if [[ -e "$APP/$rel" || -L "$APP/$rel" ]]; then residue="$residue $rel"; fi
  done < <(comm -23 <(tar -tzf "$RELEASE" | sort) <(tar -tzf "$ROLLBACK" | sort))
  while IFS= read -r rel; do
    [[ -z "$rel" || "$rel" == data/ || "$rel" == data/* ]] && continue
    if [[ -e "$APP/$rel" || -L "$APP/$rel" ]]; then residue_dirs="$residue_dirs $rel"; fi
  done < <(comm -23 <(tar -tzf "$RELEASE" | sort) <(tar -tzf "$ROLLBACK" | sort) | grep '/$' || true)
  local tree_status=0
  verify_archive_tree "$ROLLBACK" || tree_status=$?
  if [[ $tree_status -eq 0 && -z "$residue" && -z "$residue_dirs" ]]; then
    printf 'ROLLBACK_TREE=exact no_target_only_paths\n'
  else
    [[ -z "$residue" ]] || printf 'ROLLBACK_TREE_RESIDUE=%s\n' "$residue"
    [[ -z "$residue_dirs" ]] || printf 'ROLLBACK_DIR_RESIDUE=%s\n' "$residue_dirs"
  fi
  printf '%s\n' "$ROLLBACK_COMMIT" > "$APP/.deployed-commit"
  "${COMPOSE[@]}" up -d --build
  local compose_status=$?
  local rollback_health=000
  if [[ $extract_status -eq 0 && $compose_status -eq 0 ]]; then
    rollback_health=$(wait_status 200 "http://127.0.0.1:$WEB_PORT/api/health" /tmp/2j-rollback-body /tmp/2j-rollback-headers "$READINESS_TIMEOUT_SEC" || true)
  fi
  finish_rollback_verification "$extract_status" "$compose_status" "$tree_status" "$rollback_health" "$residue" "$residue_dirs"
  printf 'ROLLBACK_HEALTH=%s\n' "$rollback_health"
  printf 'LOG=%s\n' "$LOG"
  exit "$original_status"
}

on_error() {
  local status=$?
  local command=${BASH_COMMAND:-unknown}
  local step=$STEP
  # ERR is inherited by command substitutions. They must propagate failure;
  # only the top-level shell may mutate production by executing rollback.
  if (( BASH_SUBSHELL > 0 )); then
    printf 'SUBSHELL_FAIL_STEP=%s STATUS=%s COMMAND=%s\n' "$step" "$status" "$command" >&2
    exit "$status"
  fi
  rollback "$status" "$command" "$step"
}
trap on_error ERR

STEP=verify-transfer
test -s "$RELEASE"
REMOTE_HASH=$(sha256sum "$RELEASE" | awk '{print $1}')
[[ "$REMOTE_HASH" == "$EXPECTED_HASH" ]]
gzip -t "$RELEASE"
RELEASE_MARKER=$(tar -xOf "$RELEASE" SYNC_V2_ROLLBACK_BASE)
[[ "$RELEASE_MARKER" == *"$SYNC_BASE"* ]]
printf 'REMOTE_SHA256=%s\n' "$REMOTE_HASH"

STEP=verify-rollback
test -s "$ROLLBACK"
ROLLBACK_REMOTE_HASH=$(sha256sum "$ROLLBACK" | awk '{print $1}')
[[ "$ROLLBACK_REMOTE_HASH" == "$EXPECTED_ROLLBACK_HASH" ]]
gzip -t "$ROLLBACK"
ROLLBACK_MARKER=$(tar -xOf "$ROLLBACK" SYNC_V2_ROLLBACK_BASE)
[[ "$ROLLBACK_MARKER" == *"$SYNC_BASE"* ]]
printf 'ROLLBACK_OK=%s sha256=%s\n' "$ROLLBACK" "$ROLLBACK_REMOTE_HASH"


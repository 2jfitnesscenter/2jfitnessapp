    if [[ ! -L "$RELEASE_CHECK_DIR/$rel" || ! -L "$BASELINE_CHECK_DIR/$rel" ]] \
      || [[ "$(readlink "$RELEASE_CHECK_DIR/$rel")" != "$(readlink "$BASELINE_CHECK_DIR/$rel")" ]]; then
      printf '%s\n' "$rel" >> "$DELTA_PATHS"
    fi
  elif ! cmp -s "$RELEASE_CHECK_DIR/$rel" "$BASELINE_CHECK_DIR/$rel"; then
    printf '%s\n' "$rel" >> "$DELTA_PATHS"
  fi
